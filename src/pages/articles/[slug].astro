---
// An article or an activity log, built from the Paper design "V2 · Article — Serif text" with its column widened to
// 720px: the back link, the meta line, the title and the text, then the project the article belongs to and the
// previous and next posts. The text's styles are in src/styles/prose.css.
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import ProjectPanel from '../../components/ProjectPanel.astro';
import PrevNext from '../../components/PrevNext.astro';
import { projects, projectOf } from '../../data/projects';
import { isDailyLog } from '../../lib/posts.mjs';
import { newestFirst } from '../../lib/sort-posts';
import { articleMeta, postShare } from '../../lib/share';
import { excerpt } from '../../lib/excerpt';
import '../../styles/prose.css';

type Post = CollectionEntry<'writing'>;

interface Props {
  article: Post;
  previous?: Post;
  next?: Post;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('writing');
  const ids = new Set(posts.map((post) => post.id));
  for (const project of projects) {
    for (const id of project.articles) {
      if (!ids.has(id)) console.warn(`src/data/projects.ts: ${project.name} lists an article that doesn't exist: ${id}`);
    }
  }

  // Previous and Next go through the posts newest first: Previous is the older post, Next the newer one. Articles link
  // to articles, as the redesigned home's Writing list (#31) holds only articles; activity logs link to activity logs.
  return [posts.filter((post) => !isDailyLog(post)), posts.filter(isDailyLog)].flatMap((group) => {
    const sorted = group.sort(newestFirst);
    return sorted.map((article, index) => ({
      params: { slug: article.id },
      props: { article, previous: sorted[index + 1], next: sorted[index - 1] },
    }));
  });
};

const { article, previous, next } = Astro.props;
const { Content } = await render(article);
const share = postShare(article);

const project = projectOf(article.id);
// The date and reading time as the share image prints them
const { date: dateText, minutes } = articleMeta(article);
const description = article.data.description || excerpt(article.rendered?.html ?? '') || article.data.title;
const date = article.data.date;

// JSON-LD structured data for BlogPosting
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const author = {
  "@type": "Person",
  "name": "Josselin Perrus",
  "url": new URL('/about/', Astro.site).toString()
};
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.data.title,
  "description": description,
  "image": new URL(share.path, Astro.site).toString(),
  "author": author,
  "publisher": author,
  "datePublished": date.toISOString(),
  "dateModified": (article.data.updated ?? date).toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  "url": canonical
};
---

<Layout
  title={`${article.data.title} | meaningfool`}
  description={description}
  type="article"
  share={share}
>
  <JsonLd data={articleSchema} />
  <main id="main" class="post">
    <a class="back" href="/#writing">← All writing</a>
    <article>
      <header>
        <p class="meta">
          <time datetime={date.toISOString().slice(0, 10)}>{dateText}</time>
          · {minutes} min read{project && <> · <span>{project.name}</span></>}
        </p>
        <h1>{article.data.title}</h1>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
    <div class="post-end">
      {project && <ProjectPanel project={project} />}
      <PrevNext previous={previous} next={next} />
    </div>
  </main>
</Layout>

<style>
  /* A centred 720px column, which the page background leaves clear of its pattern. */
  .post {
    width: min(720px, 100%);
    margin-inline: auto;
    padding-top: 64px;
  }

  .back {
    display: block;
    width: fit-content;
    font-size: 13px;
    line-height: 20px;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  .meta {
    padding-top: 44px;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .meta span {
    color: var(--accent);
  }

  h1 {
    margin: 0;
    padding-top: 14px;
    font-weight: 400;
    font-size: 38px;
    line-height: 48px;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .prose {
    padding-top: 44px;
  }

  .post-end {
    display: grid;
    gap: 36px;
    padding-top: 72px;
  }

  @media (max-width: 900px) {
    .post {
      padding-top: 40px;
    }

    h1 {
      font-size: 28px;
      line-height: 36px;
    }
  }
</style>
