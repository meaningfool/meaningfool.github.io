---
// The home: the intro beside the topic map, then Projects and Writing. Writing lists the articles, newest first; the
// activity logs aren't listed, but their pages keep their URLs. Picking an orange dot on the map shows only the
// articles about its topic (src/data/topics.ts), and picking it again, or "Show all", shows them all again.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import JsonLd from '../components/JsonLd.astro';
import { projects, projectOf } from '../data/projects';
import { profiles } from '../data/profiles';
import { TOPIC_NAMES, topicsOf } from '../data/topics';
import { newestFirst } from '../lib/sort-posts';
import { readingMinutes } from '../lib/reading-time.mjs';
import { HOME_INTRO, articlesOnly, plural } from '../lib/share';

const title = 'meaningfool | Josselin Perrus, product manager building with AI agents';
const description =
	"Josselin Perrus's site: a product manager in Paris building AI products with AI agents. His projects, and writing on customer success, product and AI agents.";

const articles = articlesOnly(await getCollection('writing')).sort(newestFirst);
const rows = articles.map((article) => {
	const topics = topicsOf(article);
	if (!topics) console.warn(`"${article.id}" has no topics, so picking a topic on the home's map hides it: give it a topics field.`);
	return {
		href: `/articles/${article.id}/`,
		// The day in the content, as UTC keeps it whatever the build machine's time zone
		date: article.data.date.toISOString().slice(0, 10),
		title: article.data.title,
		project: projectOf(article.id)?.shortName,
		// The reading time the article page and its share image show
		minutes: readingMinutes(article.body),
		topics: topics ?? [],
	};
});
const allText = plural(rows.length, 'article');

// "May 2026", from the project's YYYY-MM
const month = (date: string) =>
	new Date(`${date}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// JSON-LD structured data for WebSite
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'meaningfool',
	url: 'https://meaningfool.net/',
	description,
	publisher: {
		'@type': 'Person',
		name: 'Josselin Perrus',
		url: 'https://meaningfool.net/about/',
	},
};
---

<Layout title={title} description={description}>
	<JsonLd data={websiteSchema} />
	<main id="main">
		<Intro label="Josselin Perrus · Product manager · Paris">
			<Fragment slot="title">I build products<br />with AI agents<span>.</span></Fragment>
			{HOME_INTRO}
			<div slot="after" class="cta-row">
				<a class="cta" href="/about/">About me <span aria-hidden="true">→</span></a>
				<ul class="profiles" role="list">
					{profiles.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
				</ul>
			</div>
		</Intro>

		<div class="stack">
			<section class="sec" aria-labelledby="projects-title">
				<div class="sec-head">
					<h2 id="projects-title">Projects</h2>
					<p class="label">Things I built to learn</p>
				</div>
				<ul class="tiles" role="list">
					{projects.map((project) => (
						<li class="tile">
							<div class="shot">
								<Image
									src={project.screenshot}
									alt=""
									widths={[362, 720]}
									sizes="(max-width: 900px) calc(100vw - 68px), min(362px, calc((100vw - 96px) / 3 - 20px))"
								/>
							</div>
							<p class="meta">{project.type} · {month(project.date)}</p>
							<h3><a href={project.link}>{project.name} <span aria-hidden="true">↗</span></a></h3>
							<p class="line">{project.description}</p>
						</li>
					))}
				</ul>
			</section>

			<section class="sec" id="writing" aria-labelledby="writing-title">
				<div class="sec-head">
					<h2 id="writing-title" tabindex="-1">Writing</h2>
					<p class="label count" data-writing-count data-all={allText} data-names={JSON.stringify(TOPIC_NAMES)} aria-live="polite">
						{allText}
					</p>
				</div>
				<ul class="index" role="list" data-writing>
					{rows.map((row) => (
						<li data-topics={row.topics.join(' ')}>
							<a class="row" href={row.href}>
								<time class="d" datetime={row.date}>{row.date}</time>
								<span class="t">{row.title}</span>
								<span class="p">{row.project ?? '—'}</span>
								<span class="r">{row.minutes} min</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</div>
	</main>
</Layout>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The intro's button and the profiles */
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
		align-items: center;
		padding-top: 6px;
	}

	.cta {
		padding: 10px 16px;
		border: 1px solid var(--ink);
		background: var(--page);
		color: var(--ink);
		text-decoration: none;
	}

	.cta span {
		color: var(--accent);
	}

	.cta:hover {
		background: var(--tint);
	}

	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 18px;
		font-size: 12px;
	}

	.profiles a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: #bcbcb5;
		text-underline-offset: 5px;
	}

	.profiles a:hover {
		text-decoration-color: var(--accent);
	}

	/* Projects and Writing */
	.stack {
		display: grid;
		gap: 88px;
	}

	.sec {
		display: grid;
		gap: 24px;
	}

	.sec-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--line);
	}

	h2 {
		margin: 0;
		font-weight: 400;
		font-size: 22px;
		letter-spacing: -0.04em;
	}

	.label {
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	.count :global(button) {
		padding: 0;
		border: 0;
		background: none;
		color: var(--accent);
		font: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	/* Projects: a tile each, its whole area a link to the project */
	.tiles {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.tile {
		position: relative;
		display: grid;
		gap: 6px;
		align-content: start;
		min-width: 0;
	}

	.shot {
		padding: 10px;
		background: var(--panel);
	}

	.shot img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border: 1px solid var(--line);
	}

	.tile .meta {
		padding-top: 10px;
		font-size: 11px;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	h3 {
		margin: 0;
		font-weight: 400;
		font-size: 16px;
		letter-spacing: -0.03em;
	}

	h3 a {
		color: inherit;
		text-decoration: none;
	}

	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	h3 a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* An inline block, so the title's underline stops before the arrow */
	h3 span {
		display: inline-block;
		color: var(--accent);
	}

	.tile .line {
		font-size: 12px;
		color: var(--muted);
	}

	/* Writing: the list is pulled up by the section's gap plus 1px, so the first row's top line lies on the heading's
	   line. */
	.index {
		display: grid;
		margin-top: -25px;
	}

	.row {
		display: grid;
		grid-template-columns: 96px minmax(0, 1fr) 120px 56px;
		gap: 16px;
		align-items: baseline;
		padding: 12px 14px 11px;
		border-top: 1px solid var(--line);
		border-bottom: 2px solid transparent;
		color: inherit;
		text-decoration: none;
	}

	.row:hover,
	.row:focus-visible {
		background: var(--tint);
		border-bottom-color: var(--accent);
	}

	.d,
	.p,
	.r {
		font-size: 12px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.r {
		text-align: right;
	}

	.t {
		font-size: 15px;
	}

	/* Phones: the tiles stack, and the rows keep only the title and the reading time. */
	@media (max-width: 900px) {
		.tiles {
			grid-template-columns: 1fr;
		}

		.row {
			grid-template-columns: minmax(0, 1fr) 48px;
		}

		.d,
		.p {
			display: none;
		}
	}
</style>

<script>
	// The topic filter. The listeners are on the document and added once, and each arrival on the home resets the list
	// and clears the map's pick, so this also works when Astro's ClientRouter swaps pages instead of loading them.
	type Writing = { list: HTMLElement; count: HTMLElement; map: HTMLElement | null };

	// The home's Writing list, or null on another page.
	function writing(): Writing | null {
		const list = document.querySelector<HTMLElement>('[data-writing]');
		const count = document.querySelector<HTMLElement>('[data-writing-count]');
		return list && count ? { list, count, map: document.querySelector<HTMLElement>('topic-map') } : null;
	}

	// Shows the articles about `topic`, or all of them, and marks the topic's dot on the map.
	function show({ list, count, map }: Writing, topic: string | null) {
		const items = [...list.querySelectorAll<HTMLElement>('li[data-topics]')];
		let shown = 0;
		for (const item of items) {
			item.hidden = !!topic && !(item.dataset.topics ?? '').split(' ').includes(topic);
			if (!item.hidden) shown++;
		}
		if (map) {
			if (topic) map.dataset.picked = topic;
			else delete map.dataset.picked;
		}
		if (topic) {
			const names: Record<string, string> = JSON.parse(count.dataset.names ?? '{}');
			const all = document.createElement('button');
			all.type = 'button';
			all.dataset.showAll = '';
			all.textContent = 'Show all';
			count.replaceChildren(`${names[topic] ?? topic} · ${shown} of ${items.length} · `, all);
		} else if (count.childElementCount || count.textContent?.trim() !== count.dataset.all) {
			// Only when it changed: the count is a live region, which screen readers announce when it's rewritten.
			count.textContent = count.dataset.all ?? '';
		}
	}

	document.addEventListener('topicmap:pick', (event) => {
		const page = writing();
		if (!page) return;
		// On the home a dot filters Writing; it never follows a link, should the map have come from another page.
		event.preventDefault();
		const map = event.target as HTMLElement;
		const { topic } = (event as CustomEvent<{ topic: string }>).detail;
		show({ ...page, map }, map.dataset.picked === topic ? null : topic);
	});

	document.addEventListener('click', (event) => {
		const button = event.target instanceof Element ? event.target.closest('[data-show-all]') : null;
		const page = button && writing();
		if (!page) return;
		const hadFocus = document.activeElement === button;
		show(page, null);
		// The button is gone: keep the keyboard's place in Writing, on its heading.
		if (hadFocus) document.getElementById('writing-title')?.focus();
	});

	// Arriving on the home, by a page load or a ClientRouter swap: all the articles, and no pick.
	function arrive() {
		const page = writing();
		if (page) show(page, null);
	}
	document.addEventListener('astro:page-load', arrive);
	arrive();

	// Leaving the home with the ClientRouter: the pick belongs to the home, so a map kept for the next page
	// (transition:persist) arrives without it.
	document.addEventListener('astro:before-swap', () => {
		const page = writing();
		if (page?.map) delete page.map.dataset.picked;
	});
</script>
