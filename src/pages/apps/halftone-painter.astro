}
function drawBrush() {
  const [hx, hy] = hover, px = cam.x + hx * cam.z, py = cam.y + hy * cam.z, R = brushR() * cam.z;
  ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
