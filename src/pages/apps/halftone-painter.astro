function frame() { if (dirty) { dirty = false; draw(); } requestAnimationFrame(frame); }

/* ---------- Undo ---------- */
const undo = [], redo = [];
function pushUndo(h = grid.h.slice()) { undo.push(h); if (undo.length > 80) undo.shift(); redo.length = 0; buttons(); }
function buttons() { $('undo').disabled = !undo.length; $('redo').disabled = !redo.length; }
function step(from, to) { if (!from.length) return; to.push(grid.h.slice()); grid.h.set(from.pop()); buttons(); dirty = true; saveDraft(); }
$('undo').onclick = () => step(undo, redo);
$('redo').onclick = () => step(redo, undo);

/* ---------- Painting ---------- */
function dab(bx, by, pressure) {
