document.querySelectorAll('[data-tool]').forEach((b) => b.addEventListener('click', () => { S.tool = b.dataset.tool; sync(); saveDraft(); }));
document.querySelectorAll('[data-size]').forEach((b) => b.addEventListener('click', () => { S.size = b.dataset.size; sync(); saveDraft(); }));
// The zoom stays, so dots and brushes keep their size on screen and only the sheet changes.
document.querySelectorAll('[data-canvas]').forEach((b) => b.addEventListener('click', () => { S.canvas = b.dataset.canvas; moved = true; sync(); saveDraft(); }));
document.querySelectorAll('[data-export]').forEach((b) => b.addEventListener('click', async () => { const kind = b.dataset.export; saveFile(`halftone-painter.${kind}`, await EXPORTS[kind]()); }));
// Clicking a button doesn't keep focus on it, so Space still moves the canvas; Tab focus works as usual.
document.querySelectorAll('button').forEach((b) => b.addEventListener('mousedown', (e) => e.preventDefault()));

const zoomBy = (k) => zoomAt(vw / 2, vh / 2, cam.z * k);
$('zoom-in').onclick = () => zoomBy(1.25);
$('zoom-out').onclick = () => zoomBy(0.8);
$('zoom-pct').onclick = () => { moved = true; fitView(); };

function closeHelp() { $('help').hidden = true; $('help-btn').setAttribute('aria-expanded', 'false'); }
$('help-btn').onclick = () => { const open = $('help').hidden; $('help').hidden = !open; $('help-btn').setAttribute('aria-expanded', String(open)); };
document.querySelectorAll('kbd[data-mod]').forEach((k) => { if (MAC) k.textContent = '⌘'; });

addEventListener('keydown', (e) => {
  const el = e.target instanceof Element ? e.target : document.body;
