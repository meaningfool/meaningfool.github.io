  setTimeout(() => URL.revokeObjectURL(a.href), 10000);
}

/* ---------- This browser's draft ---------- */
const b64 = (arr) => { let s = ''; const u = Uint8Array.from(arr, (v) => Math.round(clamp(v, 0, 100) * 2.55)); for (let i = 0; i < u.length; i += 8192) s += String.fromCharCode(...u.subarray(i, i + 8192)); return btoa(s); };
