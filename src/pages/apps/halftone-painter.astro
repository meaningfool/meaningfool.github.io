}

/* ---------- State ---------- */
const S = { tool: 'raise', size: 'm', canvas: 'm' };
const grid = { ...FULL, dx: DX, dy: DY, h: new Float32Array(FULL.cols * FULL.rows) };
let preview = null;
const brushR = () => SIZES.find(([k]) => k === S.size)[1] * DX / 2;
const sheet = () => CANVASES[S.canvas];

/* ---------- Canvas and camera: screen = cam + world * z ---------- */
const cv = $('canvas'), ctx = cv.getContext('2d');
