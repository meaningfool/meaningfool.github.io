const pressure = (e) => (e.pointerType === 'pen' && e.pressure > 0 ? e.pressure * 1.6 : 1);
const touches = new Map();
let stroke = null, pan = null, pinch = null, hover = null, space = false;
const handMode = () => S.tool === 'hand' || space;
function cursor() { cv.style.cursor = pan ? 'grabbing' : handMode() ? 'grab' : 'none'; }

// A stroke joins the undo list once it changes a dot; a click beside the map leaves the list alone.
function paintAt(x, y, p) {
  if (dab(x, y, p) && !stroke.painted) { stroke.painted = true; pushUndo(stroke.before); }
}
function cancelStroke() { if (!stroke) return; if (stroke.painted) { grid.h.set(undo.pop()); buttons(); } stroke = null; dirty = true; }
function pinchState() { const [[ax, ay], [bx, by]] = [...touches.values()]; return { cx: (ax + bx) / 2, cy: (ay + by) / 2, d: Math.hypot(ax - bx, ay - by) || 1 }; }
cv.addEventListener('pointerdown', (e) => {
  closeHelp();
  try { cv.setPointerCapture(e.pointerId); } catch {}
