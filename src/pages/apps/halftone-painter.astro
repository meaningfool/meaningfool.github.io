  draftTimer = setTimeout(() => { try { localStorage.setItem('relief-draft-3', JSON.stringify({ canvas: S.canvas, heights: b64(grid.h), tool: S.tool, size: S.size })); } catch {} }, 400);
}
function loadDraft() {
  try {
    const d = JSON.parse(localStorage.getItem('relief-draft-3') || 'null');
    if (!d) return false;
    grid.h.set(unb64(d.heights).subarray(0, grid.h.length));
    Object.assign(S, { tool: d.tool === 'hand' || d.tool === 'lower' ? d.tool : 'raise', size: SIZES.some(([k]) => k === d.size) ? d.size : 'm' });
    if (CANVASES[d.canvas]) S.canvas = d.canvas;
