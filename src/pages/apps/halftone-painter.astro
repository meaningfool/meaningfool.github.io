    if (r >= 0.05) dots.push(`<circle cx="${(posX(g, i, j) - s.x).toFixed(2)}" cy="${(posY(g, j) - s.y).toFixed(2)}" r="${r.toFixed(2)}"/>`);
  }
  return new Blob([`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w * 2}" height="${h * 2}" fill="${INK}">\n${dots.join('\n')}\n</svg>\n`], { type: 'image/svg+xml' });
