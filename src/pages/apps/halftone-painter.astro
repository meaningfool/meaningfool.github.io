/* ---------- Controls ---------- */
function sync() {
  document.querySelectorAll('[data-tool]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tool === S.tool)));
  document.querySelectorAll('[data-size]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.size === S.size)));
  document.querySelectorAll('[data-canvas]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.canvas === S.canvas)));
