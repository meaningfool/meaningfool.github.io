}
$('effects').innerHTML = Object.entries(EFFECTS).map(([k, fx]) => `<button class="fx" type="button" data-effect="${k}">${curve(fx.f)}<span>${fx.name}</span></button>`).join('');
document.querySelectorAll('[data-effect]').forEach((b) => {
  const fx = EFFECTS[b.dataset.effect];
