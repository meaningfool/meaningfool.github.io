});
addEventListener('keyup', (e) => { if (e.code === 'Space' && space) { space = false; cursor(); dirty = true; } });
addEventListener('blur', () => { space = false; hover = null; cursor(); dirty = true; });
document.documentElement.addEventListener('pointerleave', () => { if (!stroke) { hover = null; dirty = true; } });
document.addEventListener('pointerdown', (e) => { if (!e.target.closest('.br, #canvas')) closeHelp(); });

/* ---------- Export ---------- */
function exportPNG() {
  const c = document.createElement('canvas'), s = sheet();
  c.width = Math.round(s.w * PNG_Z); c.height = Math.round(s.h * PNG_Z);
