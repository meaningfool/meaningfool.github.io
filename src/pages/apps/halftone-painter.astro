---
// The Halftone Painter: raise and lower the land of a map printed in dots. It runs entirely in the browser, keeps the
// painting there (localStorage), and opens on the site's own topic map.
import App from '../../layouts/App.astro';
---

<App title="Halftone Painter | meaningfool" description="Paint a relief map in halftone dots: raise and lower the land, then export it as PNG, SVG or JSON. It runs in your browser.">
<canvas id="canvas" aria-label="Halftone map. Drag to raise or lower the ground."></canvas>

<div class="stack">
  <div class="island group undo">
    <button class="tb" id="undo" type="button" aria-label="Undo" data-tip="Undo">
      <svg viewBox="0 0 24 24"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
    </button>
    <button class="tb" id="redo" type="button" aria-label="Redo" data-tip="Redo">
      <svg viewBox="0 0 24 24"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg>
    </button>
  </div>
  <aside class="panel island" id="panel" aria-label="Tools">
    <h1><a href="/apps/" title="All apps">Halftone painter<span>.</span></a></h1>
    <section>
      <h2>Tool</h2>
      <div class="tools" role="group" aria-label="Tool">
        <button type="button" data-tool="hand" title="Move the canvas · H or hold Space">
          <svg viewBox="0 0 24 24"><path d="M18 11V6a2 2 0 0 0-4 0"/><path d="M14 10V4a2 2 0 0 0-4 0v2"/><path d="M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.9-6-2.3l-3.6-3.6a2 2 0 0 1 2.8-2.8L7 15"/></svg>Move<kbd>H</kbd>
        </button>
        <button type="button" data-tool="raise" title="Raise · R">
          <svg viewBox="0 0 24 24"><path d="M4 20h16"/><path d="M12 16V4M7 9l5-5 5 5"/></svg>Raise<kbd>R</kbd>
        </button>
        <button type="button" data-tool="lower" title="Lower · L">
          <svg viewBox="0 0 24 24"><path d="M4 20h16"/><path d="M12 4v12M7 11l5 5 5-5"/></svg>Lower<kbd>L</kbd>
        </button>
      </div>
    </section>
    <section>
      <h2>Brush size</h2>
      <div class="seg" id="sizes" role="group" aria-label="Brush size"></div>
    </section>
    <section class="wide">
      <h2>Whole map</h2>
      <div class="effects" id="effects"></div>
    </section>
    <section>
      <h2>Canvas size</h2>
      <div class="seg" id="canvases" role="group" aria-label="Canvas size"></div>
    </section>
    <section>
      <h2>Export</h2>
      <div class="exports" role="group" aria-label="Export">
        <button type="button" data-export="png" title="Image with a transparent background">PNG</button>
        <button type="button" data-export="svg" title="Vector dots, for Figma or Illustrator">SVG</button>
        <button type="button" data-export="json" title="Every dot's height, for code">JSON</button>
      </div>
    </section>
  </aside>
  <div class="island group zoom">
    <button class="tb" id="zoom-out" type="button" aria-label="Zoom out" data-tip="Zoom out">
      <svg viewBox="0 0 24 24"><path d="M6 12h12"/></svg>
    </button>
    <button class="pct" id="zoom-pct" type="button" aria-label="Fit the map" data-tip="Fit the map · Shift 1">100%</button>
    <button class="tb" id="zoom-in" type="button" aria-label="Zoom in" data-tip="Zoom in">
      <svg viewBox="0 0 24 24"><path d="M6 12h12M12 6v12"/></svg>
    </button>
  </div>
</div>

<div class="br">
  <div class="island group">
    <button class="tb" id="help-btn" type="button" aria-expanded="false" aria-controls="help" aria-label="Shortcuts" data-tip="Shortcuts">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01"/></svg>
    </button>
  </div>
  <div class="help island" id="help" hidden>
    <h2>Shortcuts</h2>
    <dl>
      <div><dt>Raise · Lower</dt><dd><kbd>R</kbd> <kbd>L</kbd></dd></div>
      <div><dt>Move the canvas</dt><dd><kbd>H</kbd> or hold <kbd>Space</kbd></dd></div>
      <div><dt>Brush size</dt><dd><kbd>[</kbd> <kbd>]</kbd></dd></div>
      <div><dt>Zoom</dt><dd><kbd data-mod>Ctrl</kbd> + scroll, or pinch</dd></div>
      <div><dt>Fit the map</dt><dd><kbd>Shift</kbd> <kbd>1</kbd></dd></div>
      <div><dt>Undo · Redo</dt><dd><kbd data-mod>Ctrl</kbd> <kbd>Z</kbd> · <kbd>Shift</kbd> <kbd data-mod>Ctrl</kbd> <kbd>Z</kbd></dd></div>
    </dl>
    <p>Scrolling moves the canvas. Your painting stays in this browser between visits.</p>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
</App>

<style is:global>
/* Layout: one full-screen canvas with the map sheet on it; down the left edge, undo, a panel with every tool, and zoom; help in the far corner. */
:root {
  --ground: #e8e7e1;
  --island: #ffffff;
  --line: #e2e1db;
  --fg: #1b1b19;
  --muted: #6c6b64;
  --hover: #f1f0eb;
  --accent: #b64b00;
  --tint: #fbeee3;
  --sheet-shadow: rgba(27, 27, 25, 0.14);
  --shadow: 0 0 0 1px rgba(27, 27, 25, 0.06), 0 1px 2px rgba(27, 27, 25, 0.06), 0 6px 16px rgba(27, 27, 25, 0.07);
  --ui: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --panel: 216px;
  --dock: 0px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --ground: #141413; --island: #232321; --line: #363631; --fg: #ecebe6; --muted: #a3a29a; --hover: #2e2e2b; --accent: #e8894a; --tint: #3b2719; --sheet-shadow: rgba(0, 0, 0, 0.6); --shadow: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 6px 18px rgba(0, 0, 0, 0.45); color-scheme: dark; }
}
:root[data-theme="dark"] { --ground: #141413; --island: #232321; --line: #363631; --fg: #ecebe6; --muted: #a3a29a; --hover: #2e2e2b; --accent: #e8894a; --tint: #3b2719; --sheet-shadow: rgba(0, 0, 0, 0.6); --shadow: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 6px 18px rgba(0, 0, 0, 0.45); color-scheme: dark; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { height: 100%; }
body { margin: 0; overflow: hidden; background: var(--ground); color: var(--fg); font: 13px/1.4 var(--ui); -webkit-font-smoothing: antialiased; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
svg { display: block; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

#canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }

.island { background: var(--island); border-radius: 10px; box-shadow: var(--shadow); }
.group { display: flex; align-items: center; gap: 2px; padding: 4px; }
.tb { position: relative; width: 36px; height: 36px; flex: none; display: grid; place-items: center; border: 0; border-radius: 7px; background: transparent; cursor: pointer; }
.tb svg { width: 20px; height: 20px; }
.tb:hover { background: var(--hover); }
.tb[disabled] { opacity: 0.35; cursor: default; background: transparent; }

/* Tooltips on hover, clear of the window's edge. */
@media (hover: hover) {
  [data-tip]:hover::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 8px); z-index: 30; padding: 5px 8px; border-radius: 6px; background: var(--fg); color: var(--island); font: 12px/1.3 var(--ui); white-space: nowrap; pointer-events: none; }
  .zoom [data-tip]:hover::after { left: 0; }
  .undo [data-tip]:hover::after { top: calc(100% + 8px); bottom: auto; left: 0; }
  .br [data-tip]:hover::after { right: 0; }
  [aria-expanded="true"][data-tip]:hover::after { display: none; }
}

.stack { position: fixed; top: calc(12px + env(safe-area-inset-top, 0px)); bottom: calc(12px + env(safe-area-inset-bottom, 0px)); left: calc(12px + env(safe-area-inset-left, 0px)); z-index: 10; width: var(--panel); display: flex; flex-direction: column; align-items: flex-start; gap: 8px; pointer-events: none; }
.stack > * { pointer-events: auto; }
.undo, .zoom { flex: none; }
.zoom { margin-top: auto; }
.panel { width: 100%; min-height: 0; overflow-y: auto; padding: 12px; display: grid; align-content: start; gap: 16px; }
.panel h1 { margin: 0; font-size: 13px; font-weight: 600; }
.panel h1 span { color: var(--accent); }
.panel h1 a { color: inherit; text-decoration: none; }
.panel h1 a:hover { text-decoration: underline; text-underline-offset: 3px; }
.panel h2 { margin: 0 0 7px; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
.tools { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding: 2px; border-radius: 8px; background: var(--hover); }
.tools button { position: relative; display: grid; justify-items: center; gap: 2px; padding: 7px 2px 5px; border: 0; border-radius: 6px; background: transparent; font-size: 12px; cursor: pointer; }
.tools svg { width: 20px; height: 20px; }
.tools button:hover { background: var(--island); }
.tools button[aria-pressed="true"] { background: var(--tint); color: var(--accent); }
.tools kbd { position: absolute; top: 4px; right: 5px; padding: 0; background: none; box-shadow: none; font: 9px/1 var(--ui); color: var(--muted); }
.seg { display: flex; gap: 2px; padding: 2px; border-radius: 8px; background: var(--hover); }
.seg button { flex: 1; min-height: 32px; padding: 4px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); font-size: 12px; cursor: pointer; display: grid; place-items: center; }
.seg button[aria-pressed="true"] { background: var(--island); color: var(--fg); box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgba(27, 27, 25, 0.08); }
.seg i { display: block; width: var(--d); height: var(--d); border-radius: 50%; background: currentColor; }
.effects { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.exports { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.fx, .exports button { border: 1px solid var(--line); border-radius: 8px; background: var(--island); font-size: 12px; cursor: pointer; }
.fx:hover, .exports button:hover { border-color: var(--accent); background: var(--tint); }
.fx { display: grid; justify-items: center; gap: 3px; padding: 8px 4px 6px; }
.exports button { min-height: 32px; }
.fx svg { width: 48px; height: 32px; stroke-width: 1; }
.fx .ax { stroke: var(--muted); opacity: 0.45; }
.fx .ref { stroke: var(--muted); opacity: 0.45; stroke-dasharray: 2 2; }
.fx .cv { stroke: var(--accent); stroke-width: 2; }

.br { position: fixed; right: calc(12px + env(safe-area-inset-right, 0px)); bottom: calc(var(--dock) + 12px + env(safe-area-inset-bottom, 0px)); z-index: 10; }
.pct { position: relative; min-width: 54px; height: 36px; border: 0; border-radius: 7px; background: transparent; font-size: 12px; font-variant-numeric: tabular-nums; cursor: pointer; }
.pct:hover { background: var(--hover); }
.help { position: absolute; right: 0; bottom: 52px; width: 300px; padding: 14px; }
.help h2 { margin: 0 0 10px; font-size: 13px; }
.help dl { margin: 0; display: grid; gap: 8px; }
.help dl div { display: flex; justify-content: space-between; gap: 12px; }
.help dt { color: var(--muted); }
.help dd { margin: 0; text-align: right; }
.help p { margin: 12px 0 0; padding-top: 10px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
kbd { font: 11px/1 var(--ui); padding: 2px 5px; border-radius: 4px; background: var(--hover); box-shadow: inset 0 -1px 0 var(--line); }

.toast { position: fixed; left: 50%; bottom: calc(var(--dock) + 68px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 30; padding: 8px 14px; border-radius: 8px; background: var(--fg); color: var(--island); font-size: 12px; white-space: nowrap; opacity: 0; transition: opacity 0.2s; pointer-events: none; }
.toast.on { opacity: 1; }
@media (prefers-reduced-motion: reduce) { .toast { transition: none; } }

/* Narrow screens: the panel becomes a strip along the bottom that scrolls sideways. */
@media (max-width: 719px) {
  :root { --dock: 116px; }
  .stack { top: auto; bottom: calc(var(--dock) + 12px + env(safe-area-inset-bottom, 0px)); width: auto; flex-direction: row; }
  .zoom { margin-top: 0; }
  .panel { position: fixed; right: 0; bottom: 0; left: 0; width: auto; height: calc(var(--dock) + env(safe-area-inset-bottom, 0px)); max-height: none; border-radius: 12px 12px 0 0; display: flex; gap: 20px; overflow: auto hidden; padding: 10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); }
  .panel h1 { flex: none; width: 76px; }
  .panel section { flex: none; width: 150px; }
  .panel section.wide { width: auto; }
  .effects { grid-template-columns: repeat(4, 64px); }
  .seg button, .exports button { min-height: 40px; }
}
</style>

<script>
/* Best of three, as on the site: [x, y, radius, weight] patches in a 420 x 300 box, before fitting. */
const BEST_PATCHES = [[0.2,0.25,0.12,0.72],[0.3,0.207,0.087,0.3],[0.131,0.213,0.076,0.307],[0.23,0.315,0.067,0.353],[0.191,0.242,0.04,0.45],[0.306,0.258,0.035,0.749],[0.226,0.337,0.033,0.462],[0.085,0.304,0.029,0.384],[0.059,0.289,0.054,-0.7],[0.226,0.383,0.037,0.782],[0.239,0.462,0.043,0.487],[0.255,0.527,0.042,0.829],[0.269,0.582,0.044,0.915],[0.303,0.655,0.034,0.624],[0.329,0.711,0.045,0.647],[0.45,0.81,0.11,0.82],[0.44,0.857,0.074,0.396],[0.389,0.83,0.076,0.453],[0.359,0.836,0.061,0.385],[0.459,0.805,0.04,0.6],[0.519,0.776,0.032,0.767],[0.557,0.749,0.024,0.522],[0.462,0.666,0.022,0.676],[0.561,0.671,0.021,0.471],[0.379,0.831,0.034,0.451],[0.52,0.63,0.042,0.95],[0.545,0.54,0.036,0.8],[0.565,0.46,0.028,0.62],[0.58,0.4,0.016,0.9],[0.566,0.726,0.037,0.615],[0.592,0.684,0.034,0.665],[0.62,0.663,0.043,0.352],[0.673,0.63,0.038,0.63],[0.716,0.594,0.034,0.529],[0.85,0.44,0.13,0.8],[0.967,0.431,0.092,0.343],[0.761,0.462,0.075,0.397],[0.817,0.518,0.088,0.429],[0.856,0.446,0.04,0.62],[0.786,0.325,0.038,0.63],[0.925,0.229,0.031,0.717],[0.858,0.275,0.025,0.476],[0.863,0.515,0.036,0.597],[0.939,0.474,0.027,0.332],[0.333,0.253,0.039,0.39],[0.385,0.264,0.031,0.368],[0.464,0.272,0.028,0.33],[0.506,0.259,0.03,0.361],[0.563,0.262,0.036,0.383],[0.594,0.282,0.036,0.335],[0.651,0.287,0.027,0.341],[0.691,0.317,0.035,0.339],[0.374,0.351,0.039,0.324],[0.406,0.383,0.035,0.305],[0.468,0.387,0.037,0.286],[0.528,0.401,0.034,0.277],[0.559,0.417,0.033,0.328],[0.624,0.411,0.027,0.273],[0.684,0.421,0.039,0.343],[0.565,0.352,0.012,0.725],[0.602,0.364,0.009,0.764],[0.463,0.32,0.016,1.286],[0.634,0.37,0.01,0.677],[0.518,0.342,0.01,0.881],[0.454,0.32,0.01,0.699],[0.681,0.364,0.012,0.768],[0.419,0.286,0.013,0.643],[0.435,0.314,0.021,1.158],[0.372,0.274,0.01,0.81],[0.05,0.55,0.018,0.895],[0.94,0.78,0.021,0.978],[0.3,0.94,0.018,0.966]];
/* The site's halftone shader, measured: ink -> share of the paper covered by dots. */
const CALIB = [[0.0,0.0],[0.01,0.002],[0.03,0.002],[0.05,0.003],[0.07,0.002],[0.09,0.004],[0.11,0.002],[0.13,0.005],[0.15,0.003],[0.17,0.005],[0.19,0.005],[0.21,0.007],[0.23,0.008],[0.25,0.009],[0.27,0.014],[0.29,0.015],[0.31,0.022],[0.33,0.025],[0.35,0.037],[0.37,0.041],[0.39,0.061],[0.41,0.068],[0.43,0.096],[0.45,0.112],[0.47,0.146],[0.49,0.175],[0.51,0.206],[0.53,0.244],[0.55,0.286],[0.57,0.323],[0.59,0.369],[0.61,0.402],[0.62,0.41]];

const W = 420, H = 300, SQ3 = Math.sqrt(3) / 2, COLS = 82, DX = W / COLS, DY = DX * SQ3;
// The site's print: the largest dot's radius is 33% of the dot spacing, with 15% grain.
const LARGEST = 0.33, GRAIN = 0.15, STRENGTH = 8, HARDNESS = 0.4;
const MARGIN = 24; // px kept clear around a fitted canvas
const PAPER = '#f5f4ef', INK = '#9a9991', PNG_Z = 2400 / W; // PNG pixels per map unit
const SIZES = [['s', 4, 'Small'], ['m', 6, 'Medium'], ['l', 10, 'Large'], ['xl', 16, 'Extra large']]; // brush width, in dots
// Every canvas has the same dots at the same spacing. The smaller ones are the centre of the largest;
// their row offsets are even, so the same rows stay shifted, and what they hide comes back on a larger one.
const FULL = { cols: 124, rows: 104 };
const canvasOf = (name, cols, rows) => { const i0 = (FULL.cols - cols) / 2, j0 = (FULL.rows - rows) / 2; return { name, cols, rows, i0, j0, x: i0 * DX, y: j0 * DY, w: (cols + 0.5) * DX, h: rows * DY }; }; // half a dot wider, for the shifted rows
const CANVASES = { s: canvasOf('Small', 54, 44), m: canvasOf('Medium', COLS, 68), l: canvasOf('Large', FULL.cols, FULL.rows) };
const MAC = /Mac|iPhone|iPad/.test(navigator.platform);
const $ = (id) => document.getElementById(id);
const clamp = (x, a, b) => Math.min(b, Math.max(a, x));

/* ---------- Whole-map effects: S-curves from height in to height out ---------- */
function logistic(k, m) { const s = (t) => 1 / (1 + Math.exp(-k * (t - m))), a = s(0), b = s(1); return (x) => (s(x) - a) / (b - a); }
function inverseLogistic(k, m) { const s = (t) => 1 / (1 + Math.exp(-k * (t - m))), a = s(0), b = s(1); return (y) => clamp(m - Math.log(1 / (a + y * (b - a)) - 1) / k, 0, 1); }
const mix = (f, amount) => (x) => x + amount * (f(x) - x);
const EFFECTS = {
  sharpen: { name: 'Sharpen', done: 'Sharpened', f: logistic(5, 0.5) },
  soften: { name: 'Soften', done: 'Softened', f: inverseLogistic(5, 0.5) },
  lift: { name: 'Lift', done: 'Lifted', f: mix(logistic(6, 0.2), 0.6) },
  sink: { name: 'Sink', done: 'Sunk', f: mix(logistic(6, 0.8), 0.6) },
};
// Specks under 1 stay sea.
const effect = (f, v) => (v < 1 ? v : 100 * clamp(f(v / 100), 0, 1));

/* ---------- The lattice: a hex grid, odd rows shifted half a dot ---------- */
function makeGrid(cols) {
  const dx = W / cols, dy = dx * SQ3, rows = Math.max(2, Math.round(H / dy));
  return { cols, rows, dx, dy, h: new Float32Array(cols * rows) };
}
const posX = (g, i, j) => (i + 0.5 + 0.5 * (j & 1)) * g.dx;
const posY = (g, j) => (j + 0.5) * g.dy;
function sampleAt(g, x, y) {
  const fy = clamp(y / g.dy - 0.5, 0, g.rows - 1), j0 = Math.min(g.rows - 2, Math.floor(fy)), ty = fy - j0;
  const rowAt = (j) => {
    const fx = clamp(x / g.dx - 0.5 - 0.5 * (j & 1), 0, g.cols - 1), i0 = Math.min(g.cols - 2, Math.floor(fx)), tx = fx - i0;
    return g.h[j * g.cols + i0] * (1 - tx) + g.h[j * g.cols + i0 + 1] * tx;
  };
  return rowAt(j0) * (1 - ty) + rowAt(j0 + 1) * ty;
}
// The first map and older drafts are one 420 x 300 picture at any density: it becomes the Medium canvas.
function place(from) {
  const m = makeGrid(COLS), { i0, j0 } = CANVASES.m;
  for (let j = 0; j < m.rows; j++) for (let i = 0; i < m.cols; i++) grid.h[(j + j0) * grid.cols + i + i0] = sampleAt(from, posX(m, i, j), posY(m, j));
}

/* ---------- Best of three ---------- */
const fitted = (ps, k = 0.927, cx = 0.546, cy = 0.533) => ps.map(([x, y, r, w]) => [0.5 + (x - cx) * k, 0.5 + (y - cy) * k, r * k, w]);
function coverage(ink) {
  for (let i = 1; i < CALIB.length; i++) if (ink <= CALIB[i][0]) {
    const [a, ca] = CALIB[i - 1], [b, cb] = CALIB[i];
    return ca + (cb - ca) * (ink - a) / (b - a);
  }
  return CALIB[CALIB.length - 1][1];
}
// Height = dot radius as a share of the largest: the square root of coverage over the shader's 0.40 maximum.
// As on the site, open sea (ink under 0.08) is masked out, and the land fades over the outer 4% of the box.
function seedBest() {
  const ps = fitted(BEST_PATCHES), g = makeGrid(COLS);
  for (let j = 0; j < g.rows; j++) for (let i = 0; i < g.cols; i++) {
