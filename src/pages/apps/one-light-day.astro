  }
}
function drawRegionLabels(v){
  if (v.co > 3e5) return;
  const add = (id, text, sub, r, deg, pri, f) => {
    const p = Pr(id), la = Math.max(f, p); if (la <= 0.02) return;
    const [x, y] = S(v, r*Math.cos(deg*DEG), r*Math.sin(deg*DEG)); if (off(x, y, 0)) return;
    lab({text, sub, x, y, r:0, pri:p > 0 ? 98 : pri, style:'region', color:SP.region, alpha:aOf(id)*la});
  };
  if (annulusVisible(v, 2.1, 3.3)) add('belt', 'Asteroid belt', null, 3.5, 208, 44, inBand(v, 2.5, 12));
  if (annulusVisible(v, 30, 50)) add('kuiper', 'Kuiper Belt', null, 52, 122, 45, inBand(v, 28, 420));
  if (v.co < 1e5){ const r = Math.max(2600, Math.min(30000, 0.62*v.half/v.k)); add('oort', 'Oort Cloud', 'edges estimated', r, 62, 46, inBand(v, 2500, 4e5)); }
}
function drawScale(v){
  const au = 110/v.k; let unit, per;
  if (au*AU_KM < 1e7){ unit = 'km'; per = 1/AU_KM; } else if (au < 30000){ unit = 'AU'; per = 1; } else { unit = 'light-years'; per = LYR; }
  const raw = au/per, p = Math.pow(10, Math.floor(Math.log10(raw))), f = raw/p, nice = (f >= 5 ? 5 : f >= 2 ? 2 : 1)*p, len = nice*per*v.k;
  const x = 14, y = H - 16;
  const valTxt = nice >= 1000 ? fmtInt(nice) : String(Number(nice.toPrecision(3)));
  const txt = `${valTxt} ${unit === 'light-years' && nice === 1 ? 'light-year' : unit} · light takes ${fmtDurCompact(nice*per*LT)}`;
  ctx.strokeStyle = 'rgba(232,237,244,0.6)'; ctx.lineWidth = 1.2; ctx.beginPath();
  ctx.moveTo(x, y - 4); ctx.lineTo(x, y + 2); ctx.moveTo(x, y); ctx.lineTo(x + len, y); ctx.moveTo(x + len, y - 4); ctx.lineTo(x + len, y + 2); ctx.stroke();
  ctx.font = F_SUB; ctx.textBaseline = 'bottom'; ctx.textAlign = 'left'; ctx.lineJoin = 'round';
  ctx.lineWidth = 3; ctx.strokeStyle = SP.halo; ctx.strokeText(txt, x, y - 6); ctx.fillStyle = 'rgba(232,237,244,0.75)'; ctx.fillText(txt, x, y - 6);
  scaleBox = {x:x - 4, y:y - 22, w:Math.max(ctx.measureText(txt).width, len) + 10, h:28};
}
// Place labels by priority; a label that would touch another label or a marker is dropped
// Labels ease toward their target opacity over about a fifth of a second: they fade in when they find room and fade out
// when they lose it (a collision, the end of their zoom range, a frame change), however fast the camera moves.
// Each label first tries the spot it will have when the camera arrives, then the spot it had; if it must move, it slides.
const labelVis = new Map(); let lastLabelT = 0;
function placeLabels(){
  const now = state.now || performance.now(), dt = DRY ? 0 : Math.min(100, Math.max(0, now - lastLabelT));
  if (!DRY) lastLabelT = now;
  const step = reduced ? 1 : dt/220, slide = reduced ? 1 : 1 - Math.exp(-dt/85);
  labels.sort((a, b) => b.pri - a.pri);
  const boxes = scaleBox ? [scaleBox] : [];
  for (const h of marks){ const m = Math.min(6, h.r + 1); boxes.push({x:h.x - m, y:h.y - m, w:2*m, h:2*m}); }
  ctx.textBaseline = 'top'; ctx.textAlign = 'left'; ctx.lineJoin = 'round';
  const seen = new Set(); let pending = false;
  for (const L of labels){
    const alpha = L.alpha == null ? 1 : L.alpha, st = L.style || 'real', key = st + '|' + L.text;
    if (seen.has(key)) continue;
    const prev = DRY ? null : labelVis.get(key);
    if (alpha <= 0.02 && !prev) continue;
    seen.add(key);
    const f = FONT[st], txt = st === 'region' ? L.text.toUpperCase() : L.text;
    ctx.font = f; const w1 = ctx.measureText(txt).width;
    let ws = 0, wt = 0; const tagTxt = L.tag ? (L.sub ? ' · ' : '') + L.tag : '';
    if (L.sub){ ctx.font = F_SUB; ws = ctx.measureText(L.sub).width; }
    if (tagTxt){ ctx.font = F_TAG; wt = ctx.measureText(tagTxt).width; }
    const two = !!(L.sub || L.tag), w = Math.max(w1, ws + wt), h = two ? 30 : (st === 'real' || st === 'fic' ? 16 : 13);
    let cands;
    if (st === 'ring') cands = [{x:L.x + 5, y:L.y - h - 2}, {x:L.x - w - 5, y:L.y - h - 2}, {x:L.x + 5, y:L.y + 3}, {x:L.x - w - 5, y:L.y + 3}];
    else if (st === 'route') cands = [{x:L.x - w/2, y:L.y - h - 7}, {x:L.x - w/2, y:L.y + 7}, {x:L.x + 9, y:L.y - h/2}, {x:L.x - w - 9, y:L.y - h/2}];
    else { const ring = rings.find(o => Math.abs(o.x - L.x) < 1 && Math.abs(o.y - L.y) < 1), g = Math.max(L.r + 7, ring ? ring.r + 3 : 0), dy = two ? 8 : h/2; cands = [{x:L.x + g, y:L.y - dy}, {x:L.x - g - w, y:L.y - dy}, {x:L.x - w/2, y:L.y - g - h}, {x:L.x - w/2, y:L.y + g}, {x:L.x + g - 4, y:L.y - g - h + 4}, {x:L.x + g - 4, y:L.y + g - 4}, {x:L.x - g - w + 4, y:L.y - g - h + 4}, {x:L.x - g - w + 4, y:L.y + g - 4}]; }
    cands.forEach((c, i) => c.i = i);
    // During a flight a label only uses its arrival spot (or, if it is leaving, the spot it has): when that spot is taken
    // it waits or fades rather than hopping somewhere else. At rest any free spot will do, arrival spot first.
    let order = cands;
    if (!DRY){
      const di = destPlace.get(key), pi = prev && prev.disp > 0.02 ? prev.ci : null;
      if (state.anim && di != null) order = [cands[di]];
      else if (state.anim && pi != null) order = [cands[pi]];
      else { const pref = [di, pi].filter(i => i != null && i < cands.length); order = [...new Set(pref)].map(i => cands[i]).concat(cands.filter(c => !pref.includes(c.i))); }
    }
    let placed = null, box = null;
    if (alpha > 0.02) for (const c of order){
      c.x = Math.max(5, Math.min(c.x, W - w - 8));
      const b = {x:c.x - 3, y:c.y - 2, w:w + 6, h:h + 3};
      if (b.x < 2 || b.y < 2 || b.x + b.w > W - 2 || b.y + b.h > H - 2) continue;
      if (boxes.some(o => b.x < o.x + o.w && b.x + b.w > o.x && b.y < o.y + o.h && b.y + b.h > o.y)) continue;
      boxes.push(b); placed = c; box = b; break;
    }
    if (DRY){ if (placed) destPlace.set(key, placed.i); continue; }
    const target = placed ? alpha : 0, d0 = prev ? prev.disp : 0;
    const disp = target > d0 ? Math.min(target, d0 + step) : Math.max(target, d0 - step);
    if (disp <= 0.005){ labelVis.delete(key); continue; }
    if (Math.abs(disp - target) > 0.005) pending = true;
    let dx, dy;
    if (placed){
      const tx = placed.x - L.x, ty = placed.y - L.y;
      if (prev && prev.disp > 0.05){ dx = prev.dx + (tx - prev.dx)*slide; dy = prev.dy + (ty - prev.dy)*slide; if (Math.abs(tx - dx) + Math.abs(ty - dy) > 0.6) pending = true; else { dx = tx; dy = ty; } }
      else { dx = tx; dy = ty; }
    } else { dx = prev.dx; dy = prev.dy; }
    labelVis.set(key, {disp, dx, dy, ci:placed ? placed.i : prev.ci, L, f, txt, tagTxt});
    ctx.save(); ctx.globalAlpha = disp; drawLabel(L, L.x + dx, L.y + dy, f, txt, tagTxt); ctx.restore();
  }
  if (DRY) return;
  // labels whose object is no longer drawn finish fading where they last were
  for (const [key, e] of labelVis){
    if (seen.has(key)) continue;
    const disp = e.disp - step;
    if (disp <= 0.005){ labelVis.delete(key); continue; }
    e.disp = disp; pending = true;
    ctx.save(); ctx.globalAlpha = disp; drawLabel(e.L, e.L.x + e.dx, e.L.y + e.dy, e.f, e.txt, e.tagTxt); ctx.restore();
  }
  if (pending) requestDraw();
}
function drawLabel(L, x, y, f, txt, tagTxt){
  ctx.font = f; ctx.lineWidth = 3.5; ctx.strokeStyle = SP.halo; ctx.strokeText(txt, x, y); ctx.fillStyle = L.color || SP.ink; ctx.fillText(txt, x, y);
  if (L.sub || tagTxt){
    let sx = x; const yy = y + 15.5;
    if (L.sub){ ctx.font = F_SUB; ctx.strokeText(L.sub, sx, yy); ctx.fillStyle = L.subColor || SP.muted; ctx.fillText(L.sub, sx, yy); sx += ctx.measureText(L.sub).width; }
    if (tagTxt){ ctx.font = F_TAG; ctx.strokeText(tagTxt, sx, yy); ctx.fillStyle = L.tagColor || SP.teal; ctx.fillText(tagTxt, sx, yy); }
  }
}

/* ---------- loop ---------- */
function requestDraw(){ if (!rafId) rafId = requestAnimationFrame(frame); }
function frame(now){
  rafId = 0; state.now = now; let more = false;
  if (state.anim){
    const a = state.anim, p = Math.max(0, Math.min(1, (now - a.t0)/a.dur)), e = p < 0.5 ? 4*p*p*p : 1 - Math.pow(-2*p + 2, 3)/2;
    a.pr = p; const [x, y, R] = a.zi.at(e); state.cur = {x, y, R};
    if (p >= 1){ state.anim = null; state.cur = null; state.rev = 1; }
    more = true;
  }
  if (state.fading.length){ state.fading = state.fading.filter(f => now - f.t0 < FO); if (state.fading.length) more = true; }
  draw();
  if (more) requestDraw();
}

new ResizeObserver(() => resize()).observe(canvas);
const startAt = Math.max(0, FRAMES.findIndex(f => '#' + f.id === location.hash));
state.i = startAt; resize(); renderCard(FRAMES[startAt]); state.rev = 1;
setInterval(() => { const fr = FRAMES[state.i]; if (fr.live) cF.textContent = liveFact(fr); }, 1000);
setInterval(() => { world = augment(computeWorld(Date.now())); requestDraw(); }, 60000);
// The canvas only uses a web font once it has loaded: ask for the three faces it draws with, then redraw
if (document.fonts && document.fonts.load){
  Promise.all([FONT.real, FONT.fic, F_SUB].map(f => document.fonts.load(f).catch(() => null))).then(() => { planArrival(); requestDraw(); });
  document.fonts.ready.then(() => requestDraw());
}
requestDraw();
})();

