  // One glyph when A and B are too close to separate; they cross-fade into the two real stars as the camera zooms in
  const one = 1 - ramp(sep, 14, 34), two = 1 - one;
  if (one > 0.01 && !off(ax, ay)){
    ctx.save(); ctx.globalAlpha = a*one; starGlyph(ax, ay, '255,225,160', '#FFF0CF', true); ctx.restore(); mark('alphacen', ax, ay, 4);
    const p = Pr('alphacen'), la = Math.max(inBand(v, 4e4, Infinity), p)*one;
    if (la > 0.02) lab({text:'Alpha Centauri', sub:'4.37 light-years', x:ax, y:ay, r:7, pri:p > 0 ? 99 : 62, color:'#FFE3A6', alpha:a*la});
  }
  if (two <= 0.01) return;
  const yr = yearNow(), rel = abRel(yr);
  const A = [ac.dx - AB.fA*rel[0], ac.dy - AB.fA*rel[1]], B = [ac.dx + AB.fB*rel[0], ac.dy + AB.fB*rel[1]];
  ctx.save(); ctx.globalAlpha = two; ctx.strokeStyle = 'rgba(255,220,160,0.28)'; ctx.lineWidth = 1;
  for (const [f, sgn] of [[AB.fA, -1], [AB.fB, 1]]){
    ctx.beginPath(); AB_PATH.forEach((p, i) => { const [x, y] = S(v, ac.dx + sgn*f*p[0], ac.dy + sgn*f*p[1]); if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y); }); ctx.stroke();
  }
  ctx.restore();
  const tw = HL('trisolaris')*two;
  if (tw > 0){
    ctx.save(); ctx.globalAlpha = tw;
    const t0 = yr*0.35, n = 220, span = 26;
    for (let seg = 0; seg < 4; seg++){
      ctx.beginPath();
      for (let i = 0; i <= n/4; i++){ const t = t0 - span + (seg*n/4 + i)/n*span, q = triPos(t), [x, y] = S(v, ac.dx + q[0], ac.dy + q[1]); if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y); }
      ctx.strokeStyle = `rgba(183,156,255,${0.1 + seg*0.12})`; ctx.lineWidth = 1.1; ctx.stroke();
    }
    const q = triPos(t0), [tx, ty] = S(v, ac.dx + q[0], ac.dy + q[1]);
    ficRing(tx, ty, 4, SP.tb); ctx.restore(); mark('trisolaris', tx, ty, 4);
    lab({text:'Trisolaris', sub:'path illustrative', subColor:SP.tbSub, style:'fic', x:tx, y:ty, r:4, pri:99, color:SP.tb, alpha:tw});
  }
  const [xa, ya] = S(v, A[0], A[1]), [xb, yb] = S(v, B[0], B[1]), sr = Math.max(4, 0.0057*v.k);
  ctx.save(); ctx.globalAlpha = two;
  starGlyph(xa, ya, '255,230,170', '#FFF4D8', false); disc(xa, ya, sr, '#FFF1CF');
  starGlyph(xb, yb, '255,200,140', '#FFE2C0', false); disc(xb, yb, sr*0.86, '#FFD9B0');
  ctx.restore();
  mark('alphaA', xa, ya, sr); mark('alphaB', xb, yb, sr);
  lab({text:'Alpha Centauri A', sub:'real star', x:xa, y:ya, r:sr, pri:74, color:'#FFE3A6', alpha:two});
  lab({text:'Alpha Centauri B', sub:'real star', x:xb, y:yb, r:sr, pri:73, color:'#FFD2A0', alpha:two});
}
// Real stars that stories use: plain, dimmed dots, except in their own frame
function drawPopStars(v, sx, sy){
  for (const p of POP){
    const o = world[p.id], [x, y] = S(v, o.dx, o.dy), m = Pr(p.id), hw = HL(p.id), app = inBand(v, o.r*0.08, Infinity, 0.15);
    if (app <= 0.01 && m <= 0.01) continue;
