}
function burst(x, y){
  ctx.save(); ctx.strokeStyle = SP.tb; ctx.lineWidth = 1.4;
  for (let i = 0; i < 8; i++){ const a = i*Math.PI/4, r1 = i % 2 ? 3 : 2.2, r2 = i % 2 ? 7.5 : 5.5; ctx.beginPath(); ctx.moveTo(x + Math.cos(a)*r1, y + Math.sin(a)*r1); ctx.lineTo(x + Math.cos(a)*r2, y + Math.sin(a)*r2); ctx.stroke(); }
  ctx.restore(); disc(x, y, 2, SP.tb);
}
// Remember a marker (labels keep clear of it); ring it if it is the frame's subject
function mark(id, x, y, r){
  marks.push({x, y, r});
  for (const l of LAYERS){
    if (l.h <= 0 || !l.fr.ringSet.has(id)) continue;
    rings.push({x, y, r:r + 12});
    ctx.save(); ctx.strokeStyle = l.col; ctx.globalAlpha = 0.28*l.h; ctx.lineWidth = 6; ctx.beginPath(); ctx.arc(x, y, r + 9, 0, TAU); ctx.stroke();
    ctx.globalAlpha = l.h; ctx.lineWidth = 1.8; ctx.beginPath(); ctx.arc(x, y, r + 9, 0, TAU); ctx.stroke(); ctx.restore();
  }
}
function hiRegion(id, sx, sy, k, lo, hi){
  for (const l of LAYERS){
    if (l.h <= 0 || !l.fr.ringSet.has(id)) continue;
    ctx.save(); ctx.strokeStyle = l.col; ctx.lineWidth = 1.5; ctx.globalAlpha = 0.85*l.h;
