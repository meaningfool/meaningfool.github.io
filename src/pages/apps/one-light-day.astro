    const u = R(); let a, ecc;
    if (u < 0.25){ a = 39.4 + (R() - 0.5)*0.9; ecc = 0.4; } else if (u < 0.8){ a = 42 + R()*5.5; ecc = 0.12; } else { a = 30 + R()*20; ecc = 0.2; }
    const th = R()*TAU, r = a*(1 + (R() - 0.5)*ecc); out.push(r*Math.cos(th), r*Math.sin(th));
  }
