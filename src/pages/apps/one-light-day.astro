      const g = ctx.createRadialGradient(x, y, 1, x, y, 11); g.addColorStop(0, 'rgba(10,12,20,1)'); g.addColorStop(0.55, 'rgba(255,143,177,0.55)'); g.addColorStop(1, 'rgba(255,143,177,0)');
