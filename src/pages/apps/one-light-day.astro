canvas.addEventListener('pointercancel', () => { swipe = null; });
window.addEventListener('hashchange', () => { const n = FRAMES.findIndex(f => '#' + f.id === location.hash); if (n >= 0 && n !== state.i) go(n); });

/* ---------- card ---------- */
function liveFact(fr){
