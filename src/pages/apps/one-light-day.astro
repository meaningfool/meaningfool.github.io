// Swipe left or right on the map to move between frames
let swipe = null;
canvas.addEventListener('pointerdown', e => { swipe = {x:e.clientX, y:e.clientY}; });
canvas.addEventListener('pointerup', e => {
  if (!swipe) return; const dx = e.clientX - swipe.x, dy = e.clientY - swipe.y; swipe = null;
  if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)*1.4) go(state.i + (dx < 0 ? 1 : -1));
