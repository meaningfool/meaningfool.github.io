function rng(seed){ return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0)/4294967296; }; }
function makeBelt(){
  const R = rng(7), out = [];
  while (out.length < 2000){
    const a = 2.1 + R()*1.2; if (Math.abs(a - 2.5) < 0.03 || Math.abs(a - 2.82) < 0.02 || Math.abs(a - 2.95) < 0.015) continue;
    const th = R()*TAU, r = a*(1 + (R() - 0.5)*0.12); out.push(r*Math.cos(th), r*Math.sin(th));
  }
  return new Float32Array(out);
}
function makeKuiper(){
  const R = rng(11), out = [];
