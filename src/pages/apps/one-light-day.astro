  planArrival();
  if (instant || reduced){ state.anim = null; state.cur = null; state.rev = 1; state.fading = []; labelVis.clear(); requestDraw(); return; }
  const zi = zoomInterp([v.ox, v.oy, v.R], [target.x, target.y, fr.R]);
  state.anim = {zi, from, t0:now, pr:0, dur:Math.max(1300, Math.min(3600, 900 + zi.S*270))};
  requestDraw();
}
prevBtn.addEventListener('click', () => go(state.i - 1));
nextBtn.addEventListener('click', () => go(state.i + 1));
window.addEventListener('keydown', e => {
  if (e.altKey || e.ctrlKey || e.metaKey) return;
  if (['ArrowRight', 'ArrowDown', 'PageDown'].includes(e.key)){ go(state.i + 1); e.preventDefault(); }
  else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)){ go(state.i - 1); e.preventDefault(); }
  else if (e.key === 'Home'){ go(0); e.preventDefault(); }
