      ctx.save(); ctx.globalAlpha = hw; ctx.setLineDash([4, 5]); ctx.strokeStyle = 'rgba(232,237,244,0.5)'; ctx.lineWidth = 1.1;
      ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(x, y); ctx.stroke(); ctx.restore();
      lab({text:p.d + ' from the Sun', x:(sx + x)/2, y:(sy + y)/2, r:0, style:'ring', pri:88, color:'#E8EDF4', alpha:hw});
    }
    if (off(x, y)) continue;
    if (m < 1 && app > 0.01){ ctx.save(); ctx.globalAlpha = (0.45*DIM() + 0.1)*app*(1 - m); disc(x, y, 1.8, p.core); ctx.restore(); }
    if (m > 0.01){
      ctx.save(); ctx.globalAlpha = m; starGlyph(x, y, p.rgb, p.core, true); ctx.restore(); mark(p.id, x, y, 6);
      lab({text:p.name, sub:W < 560 ? null : p.d, tag:p.story, tagColor:SP.pop, x, y, r:9, pri:99, color:'#FFE9D6', alpha:m});
