---
// One light-day: an interactive map from the Moon to Betelgeuse, stepped through frame by frame with Previous and Next.
// Voyager 1 crossed one light-day from Earth on 18 November 2026; each frame puts one place in that scale, real facts
// kept apart from what stories put there. Everything is drawn on a canvas from orbital elements and star positions
// in the script below; there is nothing to save, so it keeps no data. Each frame has its own #address.
import App from '../../layouts/App.astro';
---

<App title="One Light-Day | meaningfool" description="An interactive map from the Moon to Betelgeuse: where Voyager 1, one light-day from Earth, sits among the planets, the nearest stars and places that stories made famous. It runs in your browser.">
<div class="app">
  <aside class="panel" id="panel" data-kind="real" aria-label="Tour">
    <div class="p-top"><h1 class="p-app"><a href="/apps/" title="All apps">One light-day<span>.</span></a></h1><span class="p-where"><span id="pGroup">Today</span> · <span id="pCount">1 / 29</span></span></div>
    <div class="p-prog" aria-hidden="true"><i id="pBar"></i></div>
    <article class="card" id="card" aria-live="polite">
      <p class="c-k" id="cK">18 November 2026</p>
      <h2 class="c-h" id="cH">One light-day</h2>
      <p class="c-f" id="cF"></p>
      <div id="cBody"></div>
    </article>
    <nav class="p-nav" aria-label="Frames">
      <button id="prev" type="button">← Previous</button>
      <button id="next" type="button">Next →</button>
    </nav>
  </aside>
  <div class="stage">
    <canvas id="stars" aria-hidden="true"></canvas>
    <canvas id="sky" role="img" aria-label="Map of the Sun, planets, Voyager 1 and nearby stars, drawn to scale for the current frame"></canvas>
  </div>
</div>
</App>

<style is:global>
/* The site's fonts, as src/styles/tokens.css declares them. They are declared here rather than by importing tokens.css,
   because sharing that file with this page would change how /documents/ bundles its styles. */
@font-face {
	font-family: 'DejaVu Sans Mono';
	font-style: normal;
	font-weight: 400;
	font-display: swap;
	src: url('../../fonts/dejavu-sans-mono.woff2') format('woff2');
	unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD, U+2190-21FF, U+2500-257F;
}
@font-face {
	font-family: 'Newsreader';
	font-style: normal;
	font-weight: 400;
	font-display: swap;
	src: url('../../fonts/newsreader.woff2') format('woff2');
	unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
	font-family: 'Newsreader';
	font-style: italic;
	font-weight: 400;
	font-display: swap;
	src: url('../../fonts/newsreader-italic.woff2') format('woff2');
	unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

:root{
  /* A deep-space window with one caption card beside it (below it on narrow screens). One dark look by design.
     The site's fonts: Newsreader for names and text, DejaVu Sans Mono for figures and controls. */
  --space:#05070B; --panel:#0A0E14; --raise:#121823; --ink:#E8EDF4; --ink-2:#C5CEDB; --muted:#8E9AAD; --line:rgba(150,172,200,.18);
  --gold:#F2B544; --teal:#4FD1C5; --violet:#B79CFF; --pink:#FF8FB1; --on-kc:#0B0F16; --focus:#8FB6FF; --site-accent:#e8894a;
  --f-serif:Newsreader, Georgia, serif; --f-mono:"DejaVu Sans Mono", Menlo, ui-monospace, SFMono-Regular, Consolas, monospace;
}
:root:root{color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%; margin:0; overflow:hidden; background:var(--space); color:var(--ink)}
body{font:400 15.5px/1.5 var(--f-serif); -webkit-font-smoothing:antialiased}
p,h1,h2,ul{margin:0}
button{font:inherit}
:focus-visible{outline:2px solid var(--focus); outline-offset:2px}

.app{height:100%; display:grid; grid-template-columns:minmax(300px,390px) minmax(0,1fr); grid-template-areas:"panel stage"}
.stage{grid-area:stage; position:relative; min-width:0; min-height:0; overflow:hidden; background:var(--space)}
.stage canvas{position:absolute; inset:0; width:100%; height:100%; display:block}
#sky{touch-action:pan-y; user-select:none; -webkit-user-select:none}

.panel{--kc:var(--gold); grid-area:panel; min-width:0; min-height:0; display:flex; flex-direction:column; gap:14px;
  background:var(--panel); border-right:1px solid var(--line); padding:18px 22px 18px}
.panel[data-kind="exp"]{--kc:var(--teal)}
.panel[data-kind="tb"]{--kc:var(--violet)}
.panel[data-kind="pop"]{--kc:var(--pink)}
.p-top{display:flex; justify-content:space-between; align-items:baseline; gap:12px; font:400 11px/1.3 var(--f-mono); color:var(--muted)}
.p-app{font:400 13px/1.3 var(--f-mono); color:var(--ink); white-space:nowrap}
.p-app a{color:inherit; text-decoration:none}
.p-app a:hover{text-decoration:underline; text-underline-offset:3px}
.p-app span{color:var(--site-accent)}
.p-where{text-align:right; letter-spacing:.04em; text-transform:uppercase; font-variant-numeric:tabular-nums}
.p-prog{height:2px; background:var(--line); border-radius:2px; overflow:hidden; margin-top:-6px}
.p-prog i{display:block; height:100%; width:0; background:var(--kc); transition:width .5s ease, background-color .3s}

.card{flex:1 1 auto; min-height:0; overflow-y:auto; overscroll-behavior:contain; scrollbar-width:thin; scrollbar-color:var(--line) transparent; padding-right:4px}
.card.fade{-webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - 30px),transparent); mask-image:linear-gradient(to bottom,#000 calc(100% - 30px),transparent)}
.card.in{animation:cardIn .45s ease both}
@keyframes cardIn{from{opacity:.15}to{opacity:1}}
.c-k{font:400 10.5px/1.4 var(--f-mono); letter-spacing:.08em; text-transform:uppercase; color:var(--kc)}
.c-h{font:400 clamp(27px,2.5vw,33px)/1.08 var(--f-serif); letter-spacing:-.01em; margin-top:6px; text-wrap:balance}
.panel[data-fict="1"] .c-h{font-style:italic}
.c-f{margin-top:8px; font:400 12px/1.5 var(--f-mono); color:var(--ink-2); font-variant-numeric:tabular-nums}
#cBody{display:grid; gap:14px; margin-top:16px}
.c-sec{display:grid; gap:5px; padding-top:12px; border-top:1px solid var(--line)}
.c-lab{display:flex; align-items:center; gap:7px; font:400 10px/1.3 var(--f-mono); letter-spacing:.1em; text-transform:uppercase; color:var(--muted)}
.c-lab::before{content:""; width:8px; height:8px; border-radius:50%; background:var(--ink-2)}
.c-lab.fic::before{background:transparent; border:1.5px solid var(--pink)}
.c-b{color:var(--ink-2); max-width:60ch}
.c-fic{list-style:none; padding:0; display:grid; gap:7px}
.c-fic li{--lc:var(--pink); position:relative; padding-left:15px; color:var(--ink-2)}
.c-fic li::before{content:""; position:absolute; left:0; top:.6em; width:7px; height:7px; border-radius:50%; border:1.5px solid var(--lc)}
.c-fic li.f-exp{--lc:var(--teal)}
.c-fic li.f-tb{--lc:var(--violet)}
.c-fic b{font-weight:400; font-style:italic; color:var(--ink)}
.c-b a,.c-fic a{color:var(--ink); text-decoration:underline; text-decoration-color:var(--muted); text-underline-offset:3px}
.c-b a:hover,.c-fic a:hover{text-decoration-color:var(--ink)}
.c-hint{margin-top:2px; font:400 11.5px/1.5 var(--f-mono); color:var(--muted)}

.p-nav{display:grid; grid-template-columns:1fr 1.4fr; gap:10px}
.p-nav button{height:44px; border-radius:10px; border:1px solid var(--line); background:var(--raise); color:var(--ink); font:400 13.5px var(--f-mono); cursor:pointer;
  transition:background-color .2s, border-color .2s, opacity .2s}
.p-nav button:hover:not(:disabled){border-color:rgba(200,215,235,.4)}
.p-nav #next{background:var(--kc); border-color:var(--kc); color:var(--on-kc)}
.p-nav #next:hover:not(:disabled){filter:brightness(1.08)}
.p-nav button:disabled{opacity:.35; cursor:default}

@media (max-width:760px), (orientation:portrait) and (max-width:1100px){
  .app{grid-template-columns:minmax(0,1fr); grid-template-rows:minmax(0,1fr) clamp(256px,46%,430px); grid-template-areas:"stage" "panel"}
  .panel{border-right:0; border-top:1px solid var(--line); gap:10px; padding:11px 16px 12px}
  .p-prog{margin-top:-4px}
  .c-h{font-size:24px; margin-top:4px}
  .c-f{margin-top:5px; font-size:11.5px}
  #cBody{gap:10px; margin-top:10px}
  .c-sec{padding-top:9px; gap:3px}
  body{font-size:15px; line-height:1.45}
  .p-nav button{height:42px}
}
@media (prefers-reduced-motion: reduce){ .card.in{animation:none} .p-prog i{transition:none} }
</style>

<script>
(() => {
'use strict';

/* ---------- constants ---------- */
const AU_KM = 149597870.7, C_KMS = 299792.458;
const LT = AU_KM / C_KMS;            // light-seconds per AU (~499)
const LD = 86400 / LT;               // AU in one light-day (~173.14)
const LYR = 31557600 / LT;           // AU in one light-year (~63,241)
const MOON_AU = 384400 / AU_KM;
const DEG = Math.PI / 180, TAU = Math.PI * 2;
const J2000 = 2451545.0;
const jdOf = ms => ms / 86400000 + 2440587.5;
const CROSS_MS = Date.UTC(2026, 10, 18, 10, 16, 7);
const RADIO_MS = Date.UTC(1920, 10, 2);           // first commercial radio broadcast (KDKA, Pittsburgh)
const radioLY = () => (Date.now() - RADIO_MS)/31557600000;
const ALPHACEN_LY = 4.365;
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------- orbital mechanics ---------- */
// JPL approximate Keplerian elements (J2000, valid 1800-2050)
const PLANETS = [
  {id:'mercury', name:'Mercury', a:0.38709927, e:0.20563593, I:7.00497902, L0:252.25032350, lp:77.45779628, node:48.33076593, Ld:149472.67411175, rad:2439.7, base:2.2, col:'#B9B2A8', band:[0.25, 3]},
  {id:'venus',   name:'Venus',   a:0.72333566, e:0.00677672, I:3.39467605, L0:181.97909950, lp:131.60246718, node:76.67984255, Ld:58517.81538729, rad:6051.8, base:2.8, col:'#E8D3A6', band:[0.25, 3.5]},
  {id:'earth',   name:'Earth',   a:1.00000261, e:0.01671123, I:-0.00001531, L0:100.46457166, lp:102.93768193, node:0, Ld:35999.37244981, rad:6371, base:3.4, col:'#6FB3FF', band:[0, 6]},
  {id:'mars',    name:'Mars',    a:1.52371034, e:0.09339410, I:1.84969142, L0:-4.55343205, lp:-23.94362959, node:49.55953891, Ld:19140.30268499, rad:3389.5, base:2.7, col:'#E07A52', band:[0.4, 7]},
  {id:'jupiter', name:'Jupiter', a:5.20288700, e:0.04838624, I:1.30439695, L0:34.39644051, lp:14.72847983, node:100.47390909, Ld:3034.74612775, rad:69911, base:3.9, col:'#E3C49A', band:[2.5, 45]},
  {id:'saturn',  name:'Saturn',  a:9.53667594, e:0.05386179, I:2.48599187, L0:49.95424423, lp:92.59887831, node:113.66242448, Ld:1222.49362201, rad:58232, base:3.5, col:'#E8D08C', band:[5, 60]},
  {id:'uranus',  name:'Uranus',  a:19.18916464, e:0.04725744, I:0.77263783, L0:313.23810451, lp:170.95427630, node:74.01692503, Ld:428.48202785, rad:25362, base:3.1, col:'#9FE3E8', band:[10, 90]},
  {id:'neptune', name:'Neptune', a:30.06992276, e:0.00859048, I:1.77004347, L0:-55.12002969, lp:44.96476227, node:131.78422574, Ld:218.45945325, rad:24622, base:3.1, col:'#7C95FF', band:[16, 320]},
  {id:'pluto',   name:'Pluto',   a:39.48211675, e:0.24882730, I:17.14001206, L0:238.92903833, lp:224.06891629, node:110.30393684, Ld:145.20780515, rad:1188, base:2.4, col:'#CDB9A5', band:[25, 130]},
];
const CERES = {id:'ceres', a:2.7675, e:0.0785, I:10.59, lp:153.9, node:80.3, M0:220.6, ep:2460950.5, n:0.21408};
const EARTH_EL = PLANETS[2];

function meanAnomDeg(el, jd){ return el.Ld != null ? el.L0 + el.Ld*(jd - J2000)/36525 - el.lp : el.M0 + el.n*(jd - el.ep); }
function kepler(Mdeg, e){
  let M = (Mdeg*DEG) % TAU; if (M > Math.PI) M -= TAU; else if (M < -Math.PI) M += TAU;
  let E = e < 0.8 ? M + e*Math.sin(M) : (M < 0 ? -Math.PI : Math.PI);
  for (let i = 0; i < 60; i++){ const d = (E - e*Math.sin(E) - M)/(1 - e*Math.cos(E)); E -= d; if (Math.abs(d) < 1e-12) break; }
  return E;
}
function orient(el, xp, yp){
  const w = (el.lp - el.node)*DEG, O = el.node*DEG, I = el.I*DEG;
  const cw = Math.cos(w), sw = Math.sin(w), cO = Math.cos(O), sO = Math.sin(O), cI = Math.cos(I), sI = Math.sin(I);
  return {x:(cw*cO - sw*sO*cI)*xp + (-sw*cO - cw*sO*cI)*yp, y:(cw*sO + sw*cO*cI)*xp + (-sw*sO + cw*cO*cI)*yp, z:(sw*sI)*xp + (cw*sI)*yp};
}
function helio(el, jd){ const E = kepler(meanAnomDeg(el, jd), el.e); return orient(el, el.a*(Math.cos(E) - el.e), el.a*Math.sqrt(1 - el.e*el.e)*Math.sin(E)); }
function orbitPath(el, n){
  const pts = new Float64Array(2*(n + 1)), b = el.a*Math.sqrt(1 - el.e*el.e);
  for (let i = 0; i <= n; i++){ const E = i/n*TAU; const p = orient(el, el.a*(Math.cos(E) - el.e), b*Math.sin(E)); pts[2*i] = p.x; pts[2*i + 1] = p.y; }
  return pts;
}
const dirVec = (lon, lat) => ({x:Math.cos(lat*DEG)*Math.cos(lon*DEG), y:Math.cos(lat*DEG)*Math.sin(lon*DEG), z:Math.sin(lat*DEG)});
const dist3 = (a, b) => Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);
const norm3 = a => Math.hypot(a.x, a.y, a.z);

const PROBES = [
  {id:'voyager1', lon:255.9, lat:34.9, kms:16.95, jd0:jdOf(CROSS_MS), dEarth:LD},
  {id:'voyager2', lon:289.0, lat:-36.0, kms:15.3, jd0:jdOf(Date.UTC(2026, 7, 24)), dEarth:143.1609},
];
for (const p of PROBES){
  p.u = dirVec(p.lon, p.lat); p.v = p.kms*86400/AU_KM;
  const E = helio(EARTH_EL, p.jd0), b = p.u.x*E.x + p.u.y*E.y + p.u.z*E.z, c = E.x*E.x + E.y*E.y + E.z*E.z - p.dEarth*p.dEarth;
  p.r0 = b + Math.sqrt(b*b - c);
}
// Fixed points: real stars and fictional places (lon/lat ecliptic degrees, r in AU)
const FIXED = [
  {id:'tauceti', lon:17.8, lat:-24.8, r:11.91*LYR},
  {id:'wolf359', lon:162.7, lat:0.2, r:7.86*LYR},
  {id:'epseri', lon:48.2, lat:-27.7, r:10.47*LYR},
  {id:'eri40', lon:60.2, lat:-28.4, r:16.26*LYR},
  {id:'zetaret', lon:354.2, lat:-72.5, r:39.3*LYR},
  {id:'canopus', lon:105.0, lat:-75.8, r:310*LYR},
  {id:'betelgeuse', lon:88.8, lat:-16.0, r:548*LYR},
  {id:'alphacen', lon:239.5, lat:-42.6, r:ALPHACEN_LY*LYR},
  {id:'ring', lon:205, lat:0, r:21.0},                     // The Expanse: placement illustrative
  {id:'tbfleet', lon:239.5, lat:-42.6, r:2.10*LYR},        // Trisolaran fleet in Crisis Year 205
  {id:'doomsday', lon:128, lat:0, r:6.4},                // Doomsday Battle, out near Jupiter (place approximate)
  {id:'battle1', lon:335, lat:0, r:1000},                 // Dark Battle 1 (place approximate)
  {id:'battle2', lon:70, lat:-5, r:1000},                 // Dark Battle 2 (place approximate)
  {id:'bronzetarget', lon:70, lat:-5, r:26*LYR},           // Bronze Age's unnamed target star
  {id:'nh558j2', lon:335, lat:0, r:18*LYR},                // Natural Selection group's goal (direction illustrative)
];
for (const f of FIXED) f.u = dirVec(f.lon, f.lat);

function computeWorld(ms){
  const jd = jdOf(ms), w = {jd, ms};
  for (const el of PLANETS.concat([CERES])){ const p = helio(el, jd); p.dx = p.x; p.dy = p.y; w[el.id] = p; }
  const E = w.earth, lm = (218.316 + 13.176396*(jd - J2000))*DEG;
  w.moon = {x:E.x + MOON_AU*Math.cos(lm), y:E.y + MOON_AU*Math.sin(lm), z:E.z}; w.moon.dx = w.moon.x; w.moon.dy = w.moon.y;
  w.sun = {x:0, y:0, z:0, dx:0, dy:0};
  const moonAt = (pid, dist, days, ph, retro) => { const p = w[pid], a = (retro ? -1 : 1)*TAU*((jd - J2000)/days) + ph, ox = dist*Math.cos(a), oy = dist*Math.sin(a); return {x:p.x + ox, y:p.y + oy, z:p.z, dx:p.dx + ox, dy:p.dy + oy}; };
  w.ganymede = moonAt('jupiter', 0.007155, 7.1546, 1.0, false);
  w.phoebe = moonAt('saturn', 0.08657, 550.3, 2.0, true);
  for (const p of PROBES){ const r = p.r0 + p.v*(jd - p.jd0); w[p.id] = {x:r*p.u.x, y:r*p.u.y, z:r*p.u.z, r, dx:r*Math.cos(p.lon*DEG), dy:r*Math.sin(p.lon*DEG)}; }
  for (const f of FIXED){ const r = f.r; w[f.id] = {x:r*f.u.x, y:r*f.u.y, z:r*f.u.z, r, dx:r*Math.cos(f.lon*DEG), dy:r*Math.sin(f.lon*DEG)}; }
  { const sat = w.saturn, a = -0.6, d = 0.03; w.wormhole = {x:sat.x + d*Math.cos(a), y:sat.y + d*Math.sin(a), z:sat.z, dx:sat.dx + d*Math.cos(a), dy:sat.dy + d*Math.sin(a)}; }
  return w;
}
function v1EarthAU(ms){
  const jd = jdOf(ms), E = helio(EARTH_EL, jd), p = PROBES[0], r = p.r0 + p.v*(jd - p.jd0);
  return dist3({x:r*p.u.x, y:r*p.u.y, z:r*p.u.z}, E);
}
let world = computeWorld(Date.now());

// Alpha Centauri A and B: real orbit (a 23.3 AU, e 0.52, 79.9 yr, periastron 2035.6); orientation on the map is illustrative
const AB = {a:23.3, e:0.5208, P:79.91, Tp:2035.6, rot:35*DEG, fA:0.91/1.99, fB:1.08/1.99};
function abRel(year){
  const E = kepler(360*(year - AB.Tp)/AB.P, AB.e), x = AB.a*(Math.cos(E) - AB.e), y = AB.a*Math.sqrt(1 - AB.e*AB.e)*Math.sin(E);
  return [x*Math.cos(AB.rot) - y*Math.sin(AB.rot), x*Math.sin(AB.rot) + y*Math.cos(AB.rot)];
}
const AB_PATH = (() => { const out = []; for (let i = 0; i <= 240; i++) out.push(abRel(AB.Tp + AB.P*i/240)); return out; })();
const yearNow = () => 1970 + Date.now()/31557600000;
// Trisolaris: fictional chaotic orbit, drawn as an irregular illustrative path (AU from the A–B barycenter)
const triPos = t => [6.2*Math.cos(0.91*t) + 3.1*Math.cos(2.37*t + 1) + 1.5*Math.cos(5.3*t + 2), 5.6*Math.sin(1.13*t) + 2.8*Math.sin(2.71*t + 0.5) + 1.3*Math.sin(4.7*t + 1.3)];

/* ---------- formatting ---------- */
const nf = new Intl.NumberFormat('en-US', {maximumFractionDigits:0});
const fmtInt = x => nf.format(Math.round(x));
const p2 = n => String(n).padStart(2, '0');
const yrTxt = s => `${(s/31557600).toFixed(s < 31557600*10 ? 2 : 1)}`;
function fmtDurCompact(s){
  if (s < 60) return `${s < 10 ? s.toFixed(1) : Math.round(s)} s`;
  if (s < 3600){ const t = Math.round(s), m = Math.floor(t/60); return `${m} min ${p2(t % 60)} s`; }
  if (s < 172800){ const t = Math.round(s/60), h = Math.floor(t/60); return `${h} h ${p2(t % 60)} min`; }
  if (s < 86400*90) return `${(s/86400).toFixed(1)} days`;
  return `${yrTxt(s)} years`;
}
function fmtHMS(s){ const t = Math.round(s), h = Math.floor(t/3600), m = Math.floor((t % 3600)/60); return `${h} h ${p2(m)} min ${p2(t % 60)} s`; }
function fmtLTshort(s){
  if (s < 60) return `${s.toFixed(1)} light-sec`;
  if (s < 3600) return `${(s/60).toFixed(s < 600 ? 1 : 0)} light-min`;
  if (s < 172800) return `${(s/3600).toFixed(1)} light-hours`;
  if (s < 86400*60) return `${(s/86400).toFixed(1)} light-days`;
  return `${yrTxt(s)} light-years`;
}

