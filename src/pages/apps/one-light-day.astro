const lab = (o) => labels.push(o);

/* ---------- main draw ---------- */
function draw(cam){
  const v = view(cam), fr = FRAMES[state.i], now = state.now || performance.now();
  LAYERS = [];
  if (DRY) LAYERS.push({fr, h:1, p:1});
  else {
    for (const f of state.fading){ const w = 1 - ease01((now - f.t0)/FO); if (w > 0) LAYERS.push({fr:f.fr, h:f.h0*w, p:f.p0*w}); }
    const ln = layerNow(); LAYERS.push({fr, h:ln.h, p:ln.p});
  }
  DIML = 0; for (const l of LAYERS){ l.col = KCOL[l.fr.kind]; if (l.h > DIML) DIML = l.h; }
  KEEP = new Set(); if (!DRY && state.anim) for (const id of state.anim.from.hi) if (fr.hiSet.has(id)) KEEP.add(id);
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0); ctx.clearRect(0, 0, W, H);
  labels = []; marks = []; rings = []; scaleBox = null;
  const [sx, sy] = S(v, 0, 0);
  drawOort(v, sx, sy);
  drawLightRings(v);
  drawDust(v, BELT, 2.1, 3.3, 'belt', sx, sy, 1.1);
  drawDust(v, KUIPER, 30, 50, 'kuiper', sx, sy, 1.2);
  drawOrbits(v, sx, sy);
  drawTrails(v);
  drawRadio(v, sx, sy);
  drawFiction(v, sx, sy);
  drawSun(v, sx, sy);
  drawBodies(v, sx, sy);
  drawStars(v);
  drawPopStars(v, sx, sy);
  drawRegionLabels(v);
  drawScale(v);
  placeLabels();
}

function drawOort(v, sx, sy){
  const r1 = 100000*v.k;
  if (r1 < 30 || !annulusVisible(v, 2000, 100000) || 2000*v.k > v.diag*30) return;
  ctx.save(); ctx.globalAlpha = aOf('oort')*ramp(r1, 30, 90);
  const g = ctx.createRadialGradient(sx, sy, 1200*v.k, sx, sy, r1);
  g.addColorStop(0, 'rgba(130,160,210,0)'); g.addColorStop(0.06, 'rgba(130,160,210,0.08)'); g.addColorStop(0.45, 'rgba(130,160,210,0.045)'); g.addColorStop(1, 'rgba(130,160,210,0)');
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  ctx.fillStyle = 'rgba(170,195,235,0.42)'; ctx.beginPath();
  for (let i = 0; i < OORT.length; i += 2){ const x = sx + OORT[i]*v.k, y = sy - OORT[i + 1]*v.k; if (x < 0 || y < 0 || x > W || y > H) continue; ctx.rect(x, y, 1.2, 1.2); }
  ctx.fill(); ctx.restore();
  hiRegion('oort', sx, sy, v.k, 2000, 100000);
}
const LRINGS = [[1,'1 light-second'],[60,'1 light-minute'],[600,'10 light-minutes'],[3600,'1 light-hour'],[36000,'10 light-hours'],[86400,'1 light-day'],[604800,'1 light-week'],[2629800,'1 light-month'],[31557600,'1 light-year'],[315576000,'10 light-years'],[3155760000,'100 light-years']];
function drawLightRings(v){
  const E = world.earth, [ex, ey] = S(v, E.x, E.y), dw = HL('dayring'), rw = HL('radio');
  for (const [s, name] of LRINGS){
    const rp = s/LT*v.k, day = s === 86400, q = rp/v.half;
    if (q < 0.12 || q > 2.4 || !ringVisible(ex, ey, rp)) continue;
    let a = (day ? DIM() + (1 - DIM())*dw : DIM())*ramp(q, 0.12, 0.24);
    if (s === 3155760000) a *= 1 - rw;                     // the radio bubble already marks ~100 light-years
    if (a <= 0.01) continue;
    ctx.save(); ctx.globalAlpha = a;
    ctx.beginPath(); ctx.arc(ex, ey, rp, 0, TAU);
    ctx.setLineDash(day ? [7, 5] : [2, 5]); ctx.lineWidth = day ? 1.4 + 0.6*dw : 1;
    ctx.strokeStyle = day ? 'rgba(242,181,68,0.8)' : 'rgba(125,180,255,0.34)'; ctx.stroke(); ctx.restore();
    const la = day ? a : a*(1 - ramp(q, 1.2, 1.35));
    if (la <= 0.02) continue;
    for (const ang of pickOrder('ring' + s, [-52, -128, -90, -20, -160, 30, 150, 90])){
      const lx = ex + rp*Math.cos(ang*DEG), ly = ey + rp*Math.sin(ang*DEG);
      if (lx > 30 && lx < W - 30 && ly > 24 && ly < H - 24){ pickDone('ring' + s, ang); lab({text:name, x:lx, y:ly, r:0, style:'ring', pri:day ? 72 : 48, color:day ? SP.gold : 'rgba(165,205,255,0.95)', alpha:la}); break; }
    }
  }
}
function drawDust(v, arr, lo, hi, id, sx, sy, sz){
  if (hi*v.k < 12 || !annulusVisible(v, lo, hi)) return;
  ctx.save(); ctx.globalAlpha = aOf(id)*ramp(hi*v.k, 12, 30); ctx.fillStyle = SP.dust; ctx.beginPath();
  for (let i = 0; i < arr.length; i += 2){ const x = sx + arr[i]*v.k, y = sy - arr[i + 1]*v.k; if (x < 0 || y < 0 || x > W || y > H) continue; ctx.rect(x, y, sz, sz); }
  ctx.fill(); ctx.restore();
  hiRegion(id, sx, sy, v.k, lo, hi);
}
function drawOrbits(v, sx, sy){
  for (const o of ORBITS){
    const el = o.el, q = el.a*(1 - el.e), Q = el.a*(1 + el.e);
    if (Q*v.k < 3 || !annulusVisible(v, q, Q)) continue;
    let pts = o.pts; const ak = el.a*v.k;
    if (ak > 2000){ const n = Math.min(6000, Math.ceil(Math.PI/Math.acos(1 - 0.4/ak))); if (n > 256) pts = orbitPath(el, n); }
    ctx.save(); ctx.globalAlpha = aOf(el.id)*ramp(Q*v.k, 3, 10); ctx.beginPath();
    for (let i = 0; i < pts.length; i += 2){ const x = sx + pts[i]*v.k, y = sy - pts[i + 1]*v.k; if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y); }
    ctx.strokeStyle = el.id === 'earth' ? 'rgba(111,179,255,0.55)' : el.id === 'pluto' ? 'rgba(205,185,165,0.3)' : SP.orbit;
    ctx.lineWidth = 1; ctx.stroke();
    const h = HL(el.id); if (h > 0){ ctx.globalAlpha *= h; ctx.strokeStyle = 'rgba(255,255,255,0.4)'; ctx.stroke(); }
    ctx.restore();
  }
}
function drawTrails(v){
  const trail = (id, r0, col) => {
    const p = world[id]; if (p.r*v.k < 24 || p.r*v.k > 60000 || v.co > 5000) return;
    const a = Math.atan2(p.dy, p.dx), [x0, y0] = S(v, r0*Math.cos(a), r0*Math.sin(a)), [x1, y1] = S(v, p.dx, p.dy);
    const g = ctx.createLinearGradient(x0, y0, x1, y1); g.addColorStop(0, col + '0)'); g.addColorStop(1, col + '0.6)');
    ctx.save(); ctx.globalAlpha = aOf(id); ctx.strokeStyle = g; ctx.lineWidth = 1.1; ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke(); ctx.restore();
