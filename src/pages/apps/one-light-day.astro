    marker(w, 'tbfleet', (x, y) => { ctx.save(); ctx.translate(x, y); ctx.rotate(Math.PI/4); ctx.fillStyle = SP.tb; ctx.fillRect(-3.4, -3.4, 6.8, 6.8); ctx.restore(); }, 'Fleet in Crisis Year 205', 'still halfway, 2.1 light-years out', 5, 95);
  }
  if ((w = HL('darkbattle')) > 0){
    route(world.nh558j2, false, w); route(world.bronzetarget, false, w);
