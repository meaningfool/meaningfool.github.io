      if (la > 0.02) lab({text:'Voyager 1', sub:Math.abs(ltV1 - 86400) < 1800 ? '1 light-day from Earth' : fmtLTshort(ltV1), subColor:'rgba(242,205,130,0.92)', x, y, r:8, pri:p > 0 ? 99 : 70, color:SP.gold, alpha:a*la});
