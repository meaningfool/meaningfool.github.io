  if (fr.live === 'v1') return `${(d*AU_KM/1e9).toFixed(2)} billion km · ${fmtHMS(lt)} of light`;
  return fr.f;
}
function renderCard(fr){
  const n = FRAMES.length;
  panel.dataset.kind = fr.kind; panel.dataset.fict = fr.fict ? '1' : '0';
  pGroup.textContent = GROUP_NAMES[fr.grp]; pCount.textContent = `${state.i + 1} / ${n}`;
  pBar.style.width = `${(state.i/(n - 1))*100}%`;
  cK.textContent = fr.k; cH.textContent = fr.h; cF.textContent = liveFact(fr); cF.hidden = !cF.textContent;
  const fic = fr.fic || [];
  cBody.innerHTML = (fr.real ? `<section class="c-sec"><p class="c-lab">Real</p><p class="c-b">${fr.real}</p></section>` : '')
    + (fic.length ? `<section class="c-sec"><p class="c-lab fic">In fiction</p><ul class="c-fic">${fic.map(x => `<li class="f-${x.l}"><b>${x.s}</b>: ${x.t}</li>`).join('')}</ul></section>` : '')
    + (state.i === 0 ? '<p class="c-hint">Use Next and Previous, the arrow keys, or swipe across the map.</p>' : '');
