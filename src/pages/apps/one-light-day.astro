    const lx = sx + r*Math.cos(a*DEG), ly = sy + r*Math.sin(a*DEG);
    if (lx > 30 && lx < W - 30 && ly > 30 && ly < H - 30){ pickDone('radio', a); lab({text:'First radio broadcast, 1920', sub:`≈${Math.floor(radioLY())} light-years out`, x:lx, y:ly, r:2, pri:90, color:'#BFE3FF', alpha:w}); break; }
  }
