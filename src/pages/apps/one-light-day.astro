  nextBtn.textContent = state.i === 0 ? 'Start →' : 'Next →';
  cardEl.classList.remove('in'); void cardEl.offsetWidth; cardEl.classList.add('in'); cardEl.scrollTop = 0;
  requestAnimationFrame(() => { fadeCheck(); requestDraw(); });
}

// A soft fade at the bottom of the card while more text is below
function fadeCheck(){ cardEl.classList.toggle('fade', cardEl.scrollHeight - cardEl.scrollTop - cardEl.clientHeight > 4); }
cardEl.addEventListener('scroll', fadeCheck, {passive:true});

/* ---------- drawing helpers ---------- */
// Each drawn frame is a stack of layers: frames still fading out, plus the current one.
// h = how strongly its highlights and fiction show; p = how present its frame-only objects are.
const FO = 650;                                                       // ms for a frame's highlights to fade out
const ease01 = t => t <= 0 ? 0 : t >= 1 ? 1 : t*t*(3 - 2*t);
const ramp = (x, a, b) => ease01((x - a)/(b - a));
// 1 inside a zoom band, fading to 0 just outside it (d decades), so labels don't pop at the band edges
const inBand = (v, lo, hi, d = 0.06) => { const L = Math.log10(v.R); return 1 - ease01(Math.max(lo > 0 ? Math.log10(lo) - L : -1, L - Math.log10(hi))/d); };
const HL = id => { let m = 0; for (const l of LAYERS) if (l.h > m && l.fr.hiSet.has(id)) m = l.h; return m; };
let KEEP = new Set();   // objects shown by both the frame being left and the new one stay fully present in between
const Pr = id => { if (KEEP.has(id)) return 1; let m = 0; for (const l of LAYERS) if (l.p > m && l.fr.hiSet.has(id)) m = l.p; return m; };
const DIM = () => 1 - 0.5*DIML;                                       // context fades a little while a frame is shown
const aOf = id => { if (id === 'sun') return 1; const h = HL(id); return id === 'earth' ? 1 - 0.2*DIML*(1 - h) : DIM() + (1 - DIM())*h; };
function layerNow(){
  const a = state.anim; if (!a) return {h:state.rev, p:1};
  const t = a.pr*a.dur, hs = a.dur - Math.min(800, 0.38*a.dur), ps = a.dur - Math.min(1100, 0.5*a.dur);
  return {h:ease01((t - hs)/(a.dur - hs)), p:ease01((t - ps)/(a.dur - ps))};
}
// Where every label will sit once the camera arrives: computed with an invisible draw of the final view before the flight,
// so labels take those spots on the way in instead of hopping from side to side
let DRY = false;
const destPlace = new Map(), pickMem = {dest:new Map(), last:new Map()};
function planArrival(){
  const fr = FRAMES[state.i], c = frameCenter(fr);
  destPlace.clear(); pickMem.dest.clear();
  DRY = true; try { draw({x:c.x, y:c.y, R:fr.R}); } finally { DRY = false; }
}
// Order choices (e.g. where on a ring its name goes): the arrival's pick, then the last one used, then the defaults
function pickOrder(key, list){
  if (DRY) return list;
  const out = []; for (const a of [pickMem.dest.get(key), pickMem.last.get(key)]) if (a != null && !out.includes(a)) out.push(a);
  for (const a of list) if (!out.includes(a)) out.push(a); return out;
}
const pickDone = (key, a) => (DRY ? pickMem.dest : pickMem.last).set(key, a);
function disc(x, y, r, col){ ctx.beginPath(); ctx.arc(x, y, r, 0, TAU); ctx.fillStyle = col; ctx.fill(); }
function ficRing(x, y, r, col){ ctx.beginPath(); ctx.arc(x, y, r, 0, TAU); ctx.strokeStyle = col; ctx.lineWidth = 1.6; ctx.stroke(); }
function starGlyph(x, y, rgb, core, spike){
  const g = ctx.createRadialGradient(x, y, 0, x, y, 15); g.addColorStop(0, `rgba(${rgb},0.85)`); g.addColorStop(1, `rgba(${rgb},0)`);
  ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, 15, 0, TAU); ctx.fill();
  if (spike){ ctx.strokeStyle = `rgba(${rgb},0.75)`; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x - 9, y); ctx.lineTo(x + 9, y); ctx.moveTo(x, y - 9); ctx.lineTo(x, y + 9); ctx.stroke(); }
