  disc(x, y, r, '#FFF3D6'); mark('sun', x, y, r);
  const merged = 172*v.k < 14;
  if (!merged) lab({text:'Sun', sub:v.R <= 3 ? fmtLTshort(norm3(world.earth)*LT) + ' from Earth' : null, x, y, r, pri:Pr('sun') > 0 ? 99 : 80, color:'#FFE2A8'});
  else if (v.R < 7e5) lab({text:'Sun, planets & Voyager 1', sub:'all inside this dot', subColor:'rgba(242,205,130,0.92)', x, y, r:6, pri:85, color:SP.gold, alpha:DIM()});
  else lab({text:'Sun', x, y, r:5, pri:85, color:'#FFE2A8'});
}
function drawBodies(v, sx, sy){
  const w = world, E = w.earth, k = v.k;
  if (v.co < 3000){
    for (const el of PLANETS){
      const id = el.id, orb = el.a*k; if (orb < 3) continue;
      const o = w[id], [x, y] = S(v, o.dx, o.dy); if (off(x, y)) continue;
      const r = Math.max(el.base, el.rad/AU_KM*k), a = aOf(id)*ramp(orb, 3, 8);
      ctx.save(); ctx.globalAlpha = a;
      if (id === 'earth'){ ctx.beginPath(); ctx.arc(x, y, r + 2.5, 0, TAU); ctx.strokeStyle = 'rgba(111,179,255,0.35)'; ctx.lineWidth = 1; ctx.stroke(); }
      disc(x, y, r, el.col);
      if (id === 'saturn' && r >= 3){ ctx.beginPath(); ctx.ellipse(x, y, r*2.1, r*0.7, -0.45, 0, TAU); ctx.strokeStyle = 'rgba(232,208,140,0.7)'; ctx.lineWidth = 1; ctx.stroke(); }
      ctx.restore(); mark(id, x, y, r);
      const p = Pr(id), la = Math.max(inBand(v, el.band[0], el.band[1])*ramp(orb, 12, 20), p);
      if (la > 0.02) lab({text:el.name, sub:id === 'earth' ? 'you are here' : fmtLTshort(dist3(o, E)*LT), x, y, r, pri:p > 0 ? 99 : id === 'earth' ? 78 : 54, color:SP.ink, alpha:a*la});
    }
    const mo = MOON_AU*k;
    if (mo >= 8){
      const [x0, y0] = S(v, E.x, E.y), a = aOf('moon')*ramp(mo, 8, 20);
      ctx.save(); ctx.globalAlpha = a; ctx.beginPath(); ctx.arc(x0, y0, mo, 0, TAU); ctx.strokeStyle = 'rgba(200,205,215,0.22)'; ctx.lineWidth = 1; ctx.stroke();
      const [x, y] = S(v, w.moon.dx, w.moon.dy), r = Math.max(2.4, 1737.4/AU_KM*k);
      disc(x, y, r, '#C9CCD2'); ctx.restore(); mark('moon', x, y, r);
      const p = Pr('moon'), la = Math.max(inBand(v, 0, 0.05), p);
      if (la > 0.02) lab({text:'Moon', sub:'1.3 light-sec', x, y, r, pri:p > 0 ? 99 : 79, color:SP.ink, alpha:a*la});
    }
