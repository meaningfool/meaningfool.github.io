function drawSun(v, x, y){
  if (off(x, y, 60)) return;
  const r = Math.max(3.4, 0.00465*v.k), gr = Math.max(16, r*3);
  const g = ctx.createRadialGradient(x, y, 0, x, y, gr);
  g.addColorStop(0, 'rgba(255,236,190,0.95)'); g.addColorStop(Math.min(0.9, r/gr), 'rgba(255,214,140,0.55)'); g.addColorStop(1, 'rgba(255,190,100,0)');
