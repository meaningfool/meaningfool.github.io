}
function drawRadio(v, sx, sy){
  const w = HL('radio'); if (w <= 0) return;
  const r = radioLY()*LYR*v.k; if (r < 20 || !ringVisible(sx, sy, r)) return;
  ctx.save(); ctx.globalAlpha = w;
