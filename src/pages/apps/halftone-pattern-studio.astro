---
// The Halftone Pattern Studio: generate halftone rings and bands, place them on a page and export them. It runs entirely
// in the browser and keeps the saved patterns there (localStorage). It opens on the site's own corner pattern.
import App from '../../layouts/App.astro';
---

<App title="Halftone Pattern Studio | meaningfool" description="Generate halftone rings and bands, place and rotate them on a page, then export them as PNG, SVG or JSON. It runs in your browser.">
<canvas id="canvas" aria-label="The pattern on its page. Drag to move the view, or drag the orange pin to move the pattern."></canvas>

<div class="stack">
  <aside class="panel island" id="panel" aria-label="Controls">
    <h1><a href="/apps/" title="All apps">Halftone pattern studio<span>.</span></a></h1>
    <section>
      <h2>Form</h2>
      <div class="tools" role="group" aria-label="Form">
        <button type="button" data-form="rings"><svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 0 1-9-9"/><path d="M21 18A15 15 0 0 1 6 3"/></svg>Rings</button>
        <button type="button" data-form="bands"><svg viewBox="0 0 24 24"><path d="M3 10c5-6 8 6 18 0"/><path d="M3 16c5-6 8 6 18 0"/></svg>Bands</button>
      </div>
    </section>
    <section class="where" data-guides>
      <h2>Place</h2>
      <div class="place" id="places" role="group" aria-label="Place on the page"></div>
      <div class="rows">
        <div class="row" title="Turns the pattern around the orange pin, counterclockwise above 0"><label for="rotate">Rotate</label><input id="rotate" type="range"><output for="rotate"></output></div>
        <div class="row" id="dist-row" title="From the orange pin to the nearest band"><label for="dist">Distance</label><input id="dist" type="range" min="0" max="600"><output for="dist"></output></div>
      </div>
    </section>
    <section data-guides>
      <h2 id="count-label">How many rings</h2>
      <div class="seg" id="counts" role="group" aria-labelledby="count-label"></div>
      <div class="row" title="The room from one to the next. 100 is the pattern as it was drawn"><label for="gap">Gap</label><input id="gap" type="range" min="0" max="300"><output for="gap"></output></div>
    </section>
    <section>
      <h2>Pattern</h2>
      <div class="row"><label for="size">Size</label><input id="size" type="range" min="40" max="200"><output for="size"></output></div>
      <div class="row"><label for="twist">Twist</label><input id="twist" type="range" min="0" max="200"><output for="twist"></output></div>
      <div class="row"><label for="fade">Fade</label><input id="fade" type="range" min="0" max="100"><output for="fade"></output></div>
    </section>
    <section>
      <h2>Dots</h2>
      <div class="row"><label for="spacing">Spacing</label><input id="spacing" type="range" min="4" max="20"><output for="spacing"></output></div>
      <div class="row"><label for="soft">Softness</label><input id="soft" type="range" min="0" max="100"><output for="soft"></output></div>
    </section>
    <section>
      <h2>Export</h2>
      <div class="exports" role="group" aria-label="Export">
        <button type="button" data-export="png" title="Image with a transparent background">PNG</button>
        <button type="button" data-export="svg" title="Vector dots, for Figma or Illustrator">SVG</button>
        <button type="button" data-export="json" title="Every setting and curve, for code">JSON</button>
      </div>
    </section>
  </aside>
  <div class="island group zoom">
    <button class="tb" id="zoom-out" type="button" aria-label="Zoom out" title="Zoom out"><svg viewBox="0 0 24 24"><path d="M6 12h12"/></svg></button>
    <button class="pct" id="zoom-pct" type="button" aria-label="Fit the page" title="Fit the page">100%</button>
    <button class="tb" id="zoom-in" type="button" aria-label="Zoom in" title="Zoom in"><svg viewBox="0 0 24 24"><path d="M6 12h12M12 6v12"/></svg></button>
  </div>
</div>

<div class="top" id="top">
  <div class="island group">
    <button class="tb" id="undo" type="button" aria-label="Undo" title="Undo"><svg viewBox="0 0 24 24"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></button>
    <button class="tb" id="redo" type="button" aria-label="Redo" title="Redo"><svg viewBox="0 0 24 24"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg></button>
  </div>
  <div class="island group">
    <button class="tb" id="regenerate" type="button" aria-label="New pattern" title="New pattern"><svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/></svg></button>
  </div>
  <div class="island group to-saved">
    <button class="tb" id="like" type="button" aria-label="Save" title="Save" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button>
    <button class="nav" id="to-saved" type="button"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>Saved <b id="saved-count">0</b></button>
  </div>
</div>
<div class="caption" id="caption" role="status"></div>

<section class="saved-screen" id="saved" aria-label="Saved patterns" hidden>
  <div class="saved-head">
    <button class="island nav back" id="back" type="button"><svg viewBox="0 0 24 24"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>Back</button>
    <h1>Saved <span id="saved-total">0</span></h1>
  </div>
  <p class="empty" id="empty">Nothing saved yet. Press the heart on a pattern to keep it here.</p>
  <div class="grid" id="grid"></div>
</section>
</App>

<style is:global>
/* Layout: one full-screen canvas with the page on it; the panel at the top left, a row of actions beside it, and a second screen for saved patterns. */
:root {
  --ground: #e8e7e1;
  --island: #ffffff;
  --line: #e2e1db;
  --edge: #d3d2cb;
  --fg: #1b1b19;
  --muted: #6c6b64;
  --hover: #f1f0eb;
  --faint: #c9c8c0;
  --accent: #b64b00;
  --on-accent: #ffffff;
  --tint: #fbeee3;
  --sheet-shadow: rgba(27, 27, 25, 0.14);
  --shadow: 0 0 0 1px rgba(27, 27, 25, 0.06), 0 1px 2px rgba(27, 27, 25, 0.06), 0 6px 16px rgba(27, 27, 25, 0.07);
  --ui: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --panel: 248px;
  --dock: 0px;
  --left: calc(24px + var(--panel) + env(safe-area-inset-left, 0px));
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --ground: #141413; --island: #232321; --line: #363631; --edge: #4a4a44; --fg: #ecebe6; --muted: #a3a29a; --hover: #2e2e2b; --faint: #55554e; --accent: #e8894a; --on-accent: #1b1b19; --tint: #3b2719; --sheet-shadow: rgba(0, 0, 0, 0.6); --shadow: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 6px 18px rgba(0, 0, 0, 0.45); color-scheme: dark; }
}
:root[data-theme="dark"] { --ground: #141413; --island: #232321; --line: #363631; --edge: #4a4a44; --fg: #ecebe6; --muted: #a3a29a; --hover: #2e2e2b; --faint: #55554e; --accent: #e8894a; --on-accent: #1b1b19; --tint: #3b2719; --sheet-shadow: rgba(0, 0, 0, 0.6); --shadow: 0 0 0 1px rgba(255, 255, 255, 0.06), 0 6px 18px rgba(0, 0, 0, 0.45); color-scheme: dark; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { height: 100%; }
body { margin: 0; overflow: hidden; background: var(--ground); color: var(--fg); font: 13px/1.4 var(--ui); -webkit-font-smoothing: antialiased; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
svg { display: block; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

#canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }

.island { background: var(--island); border-radius: 10px; box-shadow: var(--shadow); }
.group { display: flex; align-items: center; gap: 2px; padding: 4px; flex: none; }
.tb { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border: 0; border-radius: 7px; background: transparent; cursor: pointer; }
.tb svg { width: 20px; height: 20px; }
.tb:hover { background: var(--hover); }
.tb[disabled] { opacity: 0.35; cursor: default; background: transparent; }
.tb[aria-pressed="true"] { color: var(--accent); }
.tb[aria-pressed="true"] svg { fill: var(--accent); }
.pct { min-width: 54px; height: 36px; border: 0; border-radius: 7px; background: transparent; font-size: 12px; font-variant-numeric: tabular-nums; cursor: pointer; }
.pct:hover { background: var(--hover); }

.stack { position: fixed; top: calc(12px + env(safe-area-inset-top, 0px)); bottom: calc(12px + env(safe-area-inset-bottom, 0px)); left: calc(12px + env(safe-area-inset-left, 0px)); z-index: 10; width: var(--panel); display: flex; flex-direction: column; align-items: flex-start; gap: 8px; pointer-events: none; }
.stack > * { pointer-events: auto; }
.zoom { margin-top: auto; }
.panel { width: 100%; min-height: 0; overflow-y: auto; padding: 12px; display: grid; align-content: start; gap: 14px; }
.panel h1 { margin: 0; font-size: 13px; font-weight: 600; }
.panel h1 span { color: var(--accent); }
.panel h1 a { color: inherit; text-decoration: none; }
.panel h1 a:hover { text-decoration: underline; text-underline-offset: 3px; }
.panel h2 { margin: 0 0 7px; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
.tools { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; padding: 2px; border-radius: 8px; background: var(--hover); }
.tools button { display: grid; justify-items: center; gap: 2px; padding: 7px 2px 5px; border: 0; border-radius: 6px; background: transparent; font-size: 12px; cursor: pointer; }
.tools svg { width: 20px; height: 20px; }
.tools button:hover { background: var(--island); }
.tools button[aria-pressed="true"] { background: var(--tint); color: var(--accent); }
.seg { display: flex; gap: 2px; padding: 2px; border-radius: 8px; background: var(--hover); }
.seg button { flex: 1; min-height: 32px; padding: 4px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); font-size: 12px; cursor: pointer; display: grid; place-items: center; }
.seg button[aria-pressed="true"] { background: var(--island); color: var(--fg); box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgba(27, 27, 25, 0.08); }
.place { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: 2px; padding: 2px; height: 96px; border-radius: 8px; background: var(--hover); }
.place button { padding: 0; border: 0; border-radius: 5px; background: transparent; display: grid; place-items: center; cursor: pointer; }
.place button:hover { background: var(--island); }
.place i { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--faint); }
.place button[aria-pressed="true"] { background: var(--tint); }
.place button[aria-pressed="true"] i { width: 10px; height: 10px; background: var(--accent); }
.row { display: grid; grid-template-columns: 62px minmax(0, 1fr) 36px; align-items: center; gap: 8px; min-height: 26px; font-size: 12px; }
.row label { color: var(--muted); }
.row output { text-align: right; font-variant-numeric: tabular-nums; }
.row input { width: 100%; margin: 0; accent-color: var(--accent); }
.row:has(input:disabled) { opacity: 0.45; }
.rows, .seg + .row { margin-top: 6px; }
.exports { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.exports button, .formats button { min-height: 32px; border: 1px solid var(--edge); border-radius: 8px; background: var(--island); font-size: 12px; cursor: pointer; }
.exports button:hover, .formats button:hover { border-color: var(--accent); background: var(--tint); }

.top { position: fixed; top: calc(12px + env(safe-area-inset-top, 0px)); left: var(--left); right: calc(12px + env(safe-area-inset-right, 0px)); z-index: 10; display: flex; align-items: center; gap: 8px; pointer-events: none; }
.top > * { pointer-events: auto; }
.nav { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px; border: 0; font-size: 13px; cursor: pointer; }
.nav svg { width: 20px; height: 20px; }
.group .nav { height: 36px; padding: 0 10px; border-radius: 7px; background: transparent; }
.group .nav:hover { background: var(--hover); }
.to-saved { margin-left: auto; }
.to-saved b { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--accent); }
.back { padding-left: 10px; }
.caption { position: fixed; left: var(--left); bottom: calc(9px + env(safe-area-inset-bottom, 0px)); z-index: 5; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; pointer-events: none; }

.saved-screen { position: fixed; inset: 0; z-index: 20; overflow-y: auto; display: flex; flex-direction: column; gap: 20px; background: var(--ground); padding: calc(12px + env(safe-area-inset-top, 0px)) max(12px, env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) max(12px, env(safe-area-inset-left, 0px)); }
.saved-head { display: flex; align-items: center; gap: 14px; }
.saved-head h1 { margin: 0; font-size: 13px; font-weight: 600; }
.saved-head span { margin-left: 4px; color: var(--accent); font-variant-numeric: tabular-nums; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 24px 20px; }
.card { margin: 0; display: grid; gap: 6px; min-width: 0; }
.card figcaption { font-size: 12px; color: var(--muted); }
.sheet { position: relative; aspect-ratio: 16 / 10; max-width: 100%; }
.pick { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; box-shadow: 0 2px 12px var(--sheet-shadow); cursor: pointer; transition: box-shadow 0.12s, transform 0.12s; }
@media (hover: hover) { .pick[aria-expanded="false"]:hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent), 0 10px 24px var(--sheet-shadow); transform: translateY(-2px); } }
.pick[aria-expanded="true"] { box-shadow: 0 0 0 2px var(--accent); }
.pick canvas { display: block; width: 100%; height: 100%; }
.options { position: absolute; left: 8px; right: 8px; bottom: 8px; padding: 8px; display: grid; gap: 6px; }
.load { min-height: 34px; border: 0; border-radius: 8px; background: var(--accent); color: var(--on-accent); font-size: 13px; font-weight: 600; cursor: pointer; }
.formats { display: grid; grid-template-columns: auto repeat(3, 1fr); align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
.formats button { min-height: 30px; padding: 0; color: var(--fg); }
.empty { margin: 0; max-width: 40ch; color: var(--muted); }

@media (prefers-reduced-motion: reduce) { .pick { transition: none; } .pick[aria-expanded="false"]:hover { transform: none; } }

/* Narrow screens: the panel becomes a strip along the bottom that scrolls sideways. */
@media (max-width: 719px) {
  :root { --dock: 150px; --left: calc(12px + env(safe-area-inset-left, 0px)); }
  .stack { top: auto; bottom: calc(var(--dock) + 12px + env(safe-area-inset-bottom, 0px)); width: auto; flex-direction: row; }
  .zoom { margin-top: 0; }
  .panel { position: fixed; right: 0; bottom: 0; left: 0; width: auto; height: calc(var(--dock) + env(safe-area-inset-bottom, 0px)); border-radius: 12px 12px 0 0; display: flex; gap: 20px; overflow: auto hidden; padding: 10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); }
  .panel h1 { flex: none; width: 76px; }
  .panel section { flex: none; width: 170px; }
  .panel .where { width: 300px; display: grid; grid-template-columns: 96px minmax(0, 1fr); column-gap: 12px; align-content: start; }
  .where h2 { grid-column: 1 / -1; }
  .where .rows { margin-top: 0; }
  .caption { right: calc(12px + env(safe-area-inset-right, 0px)); left: auto; bottom: calc(var(--dock) + 26px + env(safe-area-inset-bottom, 0px)); }
}
</style>

<script>
/* A pattern is a bundle of lines blended between five curves. Where the bundle folds over itself the lines pile up
   into a crease. The ink is the lines' density, blurred a touch, printed as round dots on a turned hex grid.
   Rings bend the lines around a pin; bands run them straight, a set distance from it. Either way they turn around the pin. */
const W = 1440, H = 900; // the page, in pixels
const PAPER = '#f5f4ef', INK = '#2b2b2b', PNG_SCALE = 2, ANGLE = 14;
// Darkness response measured on the reference prints: line density, blur in dot spacings, tone curve.
const FIT = {
  dens: 0.1407, gain: 0.784, gamma: 0.7615,
  tone: [[0, 0], [0.203, 0.179], [0.225, 0.195], [0.257, 0.223], [0.295, 0.285], [0.331, 0.33], [0.381, 0.413], [0.427, 0.44], [0.451, 0.46],
    [0.468, 0.483], [0.49, 0.507], [0.519, 0.542], [0.554, 0.59], [0.6, 0.646], [0.649, 0.712], [0.717, 0.841], [0.763, 0.956], [1, 1]],
};
// The rings on meaningfool.net, number 71: each ring's five curves give the distance from the pin, in reaches, at nine angles.
const SITE_NUMBER = 71, SITE_RINGS = [
  [[0.204, 0.197, 0.189, 0.185, 0.186, 0.195, 0.208, 0.224, 0.238], [0.156, 0.201, 0.285, 0.368, 0.411, 0.394, 0.325, 0.236, 0.17], [0.495, 0.582, 0.617, 0.583, 0.496, 0.394, 0.321, 0.311, 0.37], [0.463, 0.413, 0.369, 0.34, 0.33, 0.342, 0.373, 0.419, 0.471], [0.483, 0.465, 0.448, 0.439, 0.441, 0.453, 0.471, 0.486, 0.494]],
  [[0.442, 0.458, 0.485, 0.516, 0.541, 0.555, 0.555, 0.542, 0.522], [0.713, 0.716, 0.714, 0.699, 0.668, 0.618, 0.552, 0.476, 0.401], [0.664, 0.68, 0.689, 0.685, 0.663, 0.624, 0.57, 0.51, 0.457], [0.475, 0.416, 0.365, 0.328, 0.31, 0.313, 0.336, 0.374, 0.422], [0.77, 0.775, 0.787, 0.802, 0.814, 0.818, 0.813, 0.801, 0.787]],
  [[0.8, 0.804, 0.82, 0.843, 0.863, 0.874, 0.869, 0.849, 0.822], [0.622, 0.751, 0.898, 1.033, 1.129, 1.168, 1.147, 1.072, 0.96], [0.968, 1.061, 1.188, 1.306, 1.376, 1.377, 1.308, 1.192, 1.067], [1.407, 1.413, 1.397, 1.354, 1.286, 1.202, 1.113, 1.034, 0.979], [1.068, 1.097, 1.121, 1.131, 1.124, 1.101, 1.071, 1.043, 1.027]],
];
const Q = Math.PI / 2;
// The nine places, each a spot for the pin as a share of the page. Rings: the direction their curves start from, which way they turn and how far.
// Bands: the angle they take there, counterclockwise, and which way they stack from the pin (1 down the page, -1 up it).
const PLACES = {
  'top-left': { label: 'Top left', x: 0, y: 0, from: 0, turn: 1, sweep: Q, lean: 45, side: 1 },
  top: { label: 'Top', x: 0.5, y: 0, from: 2 * Q, turn: -1, sweep: 2 * Q, lean: 0, side: 1 },
  'top-right': { label: 'Top right', x: 1, y: 0, from: 2 * Q, turn: -1, sweep: Q, lean: -45, side: 1 },
  left: { label: 'Left', x: 0, y: 0.5, from: -Q, turn: 1, sweep: 2 * Q, lean: 90, side: 1 },
  middle: { label: 'Middle', x: 0.5, y: 0.5, from: 2 * Q, turn: -1, sweep: 4 * Q, lean: 0, side: 1 },
  right: { label: 'Right', x: 1, y: 0.5, from: -Q, turn: -1, sweep: 2 * Q, lean: -90, side: 1 },
  'bottom-left': { label: 'Bottom left', x: 0, y: 1, from: 0, turn: -1, sweep: Q, lean: -45, side: -1 },
  bottom: { label: 'Bottom', x: 0.5, y: 1, from: 2 * Q, turn: 1, sweep: 2 * Q, lean: 0, side: -1 },
  'bottom-right': { label: 'Bottom right', x: 1, y: 1, from: 2 * Q, turn: 1, sweep: Q, lean: 45, side: -1 },
};
// From one band's axis to the next, in page heights at size 100 and gap 100, and from the pin to the first, in pixels.
const BAND_GAP = 0.26, BAND_DIST = 225;
const $ = (id) => document.getElementById(id);
const clamp = (x, a, b) => Math.min(b, Math.max(a, x));

/* ---------- Random curves: the same number always gives the same pattern ---------- */
function randoms(seed) {
  let a = Math.imul(seed, 2654435761) >>> 0;
  const next = () => { a = (a + 0x6D2B79F5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  return (lo, hi) => lo + (hi - lo) * next();
}
const nine = (f) => Array.from({ length: 9 }, (_, i) => f(i / 8));
// Bands run on a page width past either side, so there is enough of them once they turn.
const longer = (f) => Array.from({ length: 25 }, (_, i) => f(i / 8 - 1));
const meanOf = (vs) => vs.reduce((a, b) => a + b, 0) / vs.length;
const wave = (r, amp, lo, hi) => { const a = r(-amp, amp), k = r(lo, hi), p = r(0, 6.3); return (u) => a * Math.sin(2 * Math.PI * k * u + p); };
function randomRing(r, j) {
  const centre = 0.34 + j * 0.3, thick = 0.2 * (1 + 0.25 * j), drift = wave(r, 0.04, 0.3, 0.9);
  return [0, 1, 2, 3, 4].map((k) => {
