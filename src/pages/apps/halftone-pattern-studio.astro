  commit();
}));
document.querySelectorAll('[data-count]').forEach((b) => b.addEventListener('click', () => { S[S.form].count = +b.dataset.count; commit(); }));
for (const key of SLIDERS) {
  const el = $(key);
  el.addEventListener('input', () => { bagOf(key)[key] = +el.value; readout(el); stale = true; syncSaved(); });
  el.addEventListener('change', commit);
}
// The bands' axes show while the pointer is on the controls that place them.
document.querySelectorAll('[data-guides]').forEach((el) => {
  el.addEventListener('pointerenter', () => { guides = true; dirty = true; });
  el.addEventListener('pointerleave', () => { guides = false; dirty = true; });
});
$('regenerate').onclick = () => {
  const f = S[S.form];
  let n = f.seed;
  while (n === f.seed) n = 1 + Math.floor(Math.random() * 9999);
  f.seed = n; commit();
};
document.querySelectorAll('[data-export]').forEach((b) => b.addEventListener('click', () => saveExport(b.dataset.export, current())));
// Clicking a button doesn't keep focus on it; Tab focus works as usual.
document.querySelectorAll('button').forEach((b) => b.addEventListener('mousedown', (e) => e.preventDefault()));

const zoomBy = (k) => zoomAt(vw / 2, vh / 2, cam.z * k);
$('zoom-in').onclick = () => zoomBy(1.25);
$('zoom-out').onclick = () => zoomBy(0.8);
$('zoom-pct').onclick = () => { moved = false; fitView(); };

/* ---------- Moving the view and the pin ---------- */
const touches = new Map();
let pan = null, pinch = null, pinDrag = false;
const nearPin = (x, y) => Math.hypot(x - pinScreen()[0], y - pinScreen()[1]) < 18;
function cursor(x, y) { cv.style.cursor = pinDrag || pan ? 'grabbing' : x !== undefined && nearPin(x, y) ? 'move' : 'grab'; }
function pinchState() { const [[ax, ay], [bx, by]] = [...touches.values()]; return { cx: (ax + bx) / 2, cy: (ay + by) / 2, d: Math.hypot(ax - bx, ay - by) || 1 }; }
cv.addEventListener('pointerdown', (e) => {
  try { cv.setPointerCapture(e.pointerId); } catch {}
  if (e.pointerType === 'touch') {
    touches.set(e.pointerId, [e.clientX, e.clientY]);
    if (touches.size === 2) { pan = null; pinDrag = false; pinch = { ...pinchState(), z: cam.z }; return; }
    if (touches.size > 2) return;
  }
  if (nearPin(e.clientX, e.clientY)) pinDrag = true;
  else pan = { x: e.clientX, y: e.clientY };
  cursor();
});
cv.addEventListener('pointermove', (e) => {
  if (touches.has(e.pointerId)) touches.set(e.pointerId, [e.clientX, e.clientY]);
  if (pinch) {
    if (touches.size < 2) return;
    const p = pinchState();
    zoomAt(pinch.cx, pinch.cy, pinch.z * (p.d / pinch.d));
    cam.x += p.cx - pinch.cx; cam.y += p.cy - pinch.cy;
    pinch = { ...pinch, cx: p.cx, cy: p.cy };
    return;
  }
  if (pinDrag) {
    const f = S[S.form], s = PLACES[f.place], [x, y] = toPage(e.clientX, e.clientY);
    f.dx = Math.round(clamp(x, 0, W) - s.x * W); f.dy = Math.round(clamp(y, 0, H) - s.y * H);
    stale = true; syncSaved();
    return;
  }
  if (pan) { cam.x += e.clientX - pan.x; cam.y += e.clientY - pan.y; pan = { x: e.clientX, y: e.clientY }; moved = true; dirty = true; return; }
  cursor(e.clientX, e.clientY);
});
function endPointer(e) {
  touches.delete(e.pointerId);
  if (pinch) { if (!touches.size) pinch = null; return; }
  if (pinDrag) { pinDrag = false; dirty = true; commit(); }
  pan = null; cursor();
}
cv.addEventListener('pointerup', endPointer);
cv.addEventListener('pointercancel', endPointer);
cv.addEventListener('wheel', (e) => {
  e.preventDefault();
  const k = e.deltaMode === 1 ? 16 : 1;
  // A mouse wheel notch zooms by about a quarter; a trackpad pinch sends many small steps.
  if (e.ctrlKey || e.metaKey) zoomAt(e.clientX, e.clientY, cam.z * Math.exp(-clamp(e.deltaY * k, -40, 40) * 0.006));
  else {
    const [dx, dy] = e.shiftKey && !e.deltaX ? [e.deltaY, 0] : [e.deltaX, e.deltaY];
    cam.x -= dx * k; cam.y -= dy * k; moved = true; dirty = true;
  }
}, { passive: false });
// Safari's trackpad pinch.
let gestureZ = 0;
cv.addEventListener('gesturestart', (e) => { e.preventDefault(); gestureZ = cam.z; });
cv.addEventListener('gesturechange', (e) => { e.preventDefault(); zoomAt(e.clientX, e.clientY, gestureZ * e.scale); });
addEventListener('keydown', (e) => {
  const mod = e.metaKey || e.ctrlKey, key = e.key.toLowerCase();
  if (e.key === 'Escape' && !$('saved').hidden) { showSaved(false, true); return; }
  if (!$('saved').hidden) return;
  if (mod && key === 'z') { e.preventDefault(); step(e.shiftKey ? future : past, e.shiftKey ? past : future); return; }
  if (mod && key === 'y') { e.preventDefault(); step(future, past); return; }
  if (mod && (key === '=' || key === '+')) { e.preventDefault(); zoomBy(1.25); return; }
  if (mod && key === '-') { e.preventDefault(); zoomBy(0.8); return; }
  if (mod && key === '0') { e.preventDefault(); moved = false; fitView(); }
});

/* ---------- Export ---------- */
const EXPORTS = {
  png: { ext: 'png', make(p) {
    const c = document.createElement('canvas'), z = PNG_SCALE;
    c.width = W * z; c.height = H * z;
    paint(c.getContext('2d'), dotsFor(p), 0, 0, z, c.width, c.height);
    return new Promise((done) => c.toBlob(done, 'image/png'));
  } },
  svg: { ext: 'svg', make(p) {
    const d = dotsFor(p), body = d.xs.map((x, i) => `<circle cx="${x.toFixed(1)}" cy="${d.ys[i].toFixed(1)}" r="${d.rs[i].toFixed(2)}"/>`);
    return new Blob([`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" fill="${INK}">\n${body.join('\n')}\n</svg>\n`], { type: 'image/svg+xml' });
  } },
  // Every setting, plus the curves themselves, so code can rebuild the pattern without this page.
  json: { ext: 'json', make(p) {
    const lines = bundles(p).map(({ curves, ink, off }) => ({ ink: +ink.toFixed(3), offset: +off.toFixed(3), curves: curves.map((c) => c.map((v) => +v.toFixed(3))) }));
    const all = { format: 'halftone-field/2', page: [W, H], name: nameOf(p), settings: p, ink: INK, print: { ...FIT, angle: ANGLE }, lines };
    return new Blob([JSON.stringify(all, null, 2) + '\n'], { type: 'application/json' });
  } },
};
async function saveExport(kind, p) {
  const { ext, make } = EXPORTS[kind];
  saveFile(`halftone-${p.form}-${p.seed}.${ext}`, await make(p));
}
function saveFile(name, blob) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name; a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 10000);
}

/* ---------- Saved patterns: kept in this browser ---------- */
const LOCAL = 'field-saved-1';
// What a first visit finds on the Saved screen. They're ordinary saved patterns: the heart removes them.
const STARTERS = [
  { form: 'rings', seed: SITE_NUMBER, place: 'top-right', count: 3, size: 142, twist: 165, fade: 60 },
  { form: 'bands', seed: 12, place: 'top-left', count: 3, size: 100, twist: 100, fade: 60 },
  { form: 'rings', seed: 8, place: 'left', count: 3, size: 120, twist: 100, fade: 60, rotate: 50 },
  { form: 'bands', seed: 12, place: 'middle', count: 3, size: 70, twist: 100, fade: 60, gap: 200, rotate: 45 },
].map((pattern, n) => ({ id: `starter-${n}`, at: 4 - n, pattern }));
let saved = [], opened = null;
const thumbs = new Map();
function readLocal() {
  try {
    const kept = localStorage.getItem(LOCAL);
    if (kept === null) return STARTERS;
    const list = JSON.parse(kept);
    return Array.isArray(list) ? list : [];
  } catch { return STARTERS; }
}
const stored = (id, data) => ({ id: String(id), at: Number(data?.at) || 0, pattern: checked(data?.pattern) });
const writeLocal = () => { try { localStorage.setItem(LOCAL, JSON.stringify(saved)); } catch {} };
const newest = () => saved.sort((a, b) => b.at - a.at);
function toggleSaved() {
  const p = current(), key = keyOf(p), hit = saved.find((s) => keyOf(s.pattern) === key);
  if (hit) {
    saved = saved.filter((s) => s !== hit);
  } else {
    saved.unshift({ id: `p${Date.now().toString(36)}${Math.floor(Math.random() * 1e6).toString(36)}`, at: Date.now(), pattern: p });
  }
  writeLocal(); syncSaved();
}
$('like').onclick = toggleSaved;
function syncSaved() {
  const on = saved.some((s) => keyOf(s.pattern) === keyOf(current()));
  $('like').setAttribute('aria-pressed', String(on));
  $('like').setAttribute('aria-label', on ? 'Remove from saved' : 'Save');
  $('like').title = on ? 'Remove from saved' : 'Save';
  $('saved-count').textContent = saved.length;
}
function renderSaved() {
  $('saved-total').textContent = saved.length;
  $('empty').hidden = saved.length > 0;
  $('grid').replaceChildren(...saved.map((s) => {
    const card = document.createElement('figure'), sheet = document.createElement('div'), pick = document.createElement('button');
    card.className = 'card'; sheet.className = 'sheet'; pick.className = 'pick'; pick.type = 'button';
    pick.setAttribute('aria-label', nameOf(s.pattern));
    pick.setAttribute('aria-expanded', String(opened === s.id));
    pick.append(thumb(s));
    pick.onclick = () => { opened = opened === s.id ? null : s.id; renderSaved(); };
    sheet.append(pick);
    if (opened === s.id) {
      const box = document.createElement('div'), load = document.createElement('button'), formats = document.createElement('div');
      box.className = 'options island'; load.className = 'load'; load.type = 'button'; load.textContent = 'Load in editor';
      load.onclick = (e) => { adopt(s.pattern); commit(); showSaved(false, !e.detail); };
      formats.className = 'formats'; formats.setAttribute('role', 'group'); formats.setAttribute('aria-label', 'Export');
      formats.append('Export');
      for (const [kind, name] of [['png', 'PNG'], ['svg', 'SVG'], ['json', 'JSON']]) {
        const b = document.createElement('button');
        b.type = 'button'; b.textContent = name; b.onclick = () => saveExport(kind, s.pattern);
        formats.append(b);
      }
      box.append(load, formats); sheet.append(box);
    }
    const name = document.createElement('figcaption');
    name.textContent = nameOf(s.pattern);
    card.append(sheet, name);
    return card;
  }));
  paintThumbs();
}
function thumb(s) {
  if (!thumbs.has(s.id)) {
    const c = document.createElement('canvas');
    c.width = 680; c.height = 425;
    const g = c.getContext('2d'); g.fillStyle = PAPER; g.fillRect(0, 0, c.width, c.height);
    thumbs.set(s.id, { c, drawn: false, pattern: s.pattern });
  }
  return thumbs.get(s.id).c;
}
// One at a time, so the screen answers while they draw.
function paintThumbs() {
  const next = [...thumbs.values()].find((t) => !t.drawn);
  if (!next) return;
  next.drawn = true;
  setTimeout(() => {
    const z = next.c.width / W;
    paint(next.c.getContext('2d'), dotsFor(next.pattern), 0, 0, z, next.c.width, next.c.height);
    paintThumbs();
  }, 0);
}
// Focus moves with the screen only for the keyboard: after a click it would just put a ring on a button.
function showSaved(on, keys) {
  $('saved').hidden = !on;
  if (on) { opened = null; renderSaved(); $('saved').scrollTop = 0; }
  if (keys) $(on ? 'back' : 'to-saved').focus({ preventScroll: true });
}
$('to-saved').onclick = (e) => showSaved(true, !e.detail);
$('back').onclick = (e) => showSaved(false, !e.detail);

/* ---------- This browser's draft ---------- */
let draftTimer = 0;
function saveDraft() {
  clearTimeout(draftTimer);
  draftTimer = setTimeout(() => { try { localStorage.setItem('field-draft-1', shown); } catch {} }, 400);
}
function loadDraft() {
  try {
    const d = JSON.parse(localStorage.getItem('field-draft-1') || 'null');
    if (!d) return;
    const rings = checked({ form: 'rings', ...d.rings, ...d.dots }), bands = checked({ form: 'bands', ...d.bands, ...d.dots });
    const { spacing, soft } = rings;
    S = { form: d.form === 'bands' ? 'bands' : 'rings', rings: { ...rings }, bands: { ...bands }, dots: { spacing, soft } };
    for (const f of [S.rings, S.bands]) for (const k of ['form', 'spacing', 'soft']) delete f[k];
    shown = JSON.stringify(S);
  } catch {}
}

/* ---------- Start ---------- */
loadDraft();
saved = readLocal().map((s) => stored(s?.id, s));
newest();
readTheme(); sync(); resize(); cursor();
new ResizeObserver(resize).observe(cv);
matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readTheme);
new MutationObserver(readTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
requestAnimationFrame(frame);
</script>
