---
// TEMPORARY (#30): shows the intro block and the topic map on the redesign branch's previews, until the home (#31)
// uses them. #31 deletes this page, with its line in astro.config.mjs. It isn't linked, indexed or in the sitemap.
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
---

<Layout title="Map preview | meaningfool" noindex>
	<main id="main">
		<Intro label="Josselin Perrus · Product manager · Paris">
			<Fragment slot="title">I build products<br />with AI agents<span>.</span></Fragment>
			I'm a product manager building AI products with AI. My projects are an opportunity to test ideas and learn in public.
			<p slot="after" class="note">Temporary preview of the intro and the map (#30). Clicking an orange dot marks it as picked; the home (#31) will filter Writing with it.</p>
		</Intro>
	</main>
</Layout>

<style>
	.note {
		padding-top: 6px;
		font-size: 12px;
		color: var(--muted);
	}
</style>

<script>
	// TEMPORARY (#30): what the home will do with a picked dot, minus the filtering.
	document.addEventListener('topicmap:pick', (e) => {
		const map = e.target as HTMLElement;
		const topic = (e as CustomEvent<{ topic: string }>).detail.topic;
		if (map.dataset.picked === topic) delete map.dataset.picked;
		else map.dataset.picked = topic;
	});
</script>
