---
// The page background, fixed behind every page's frame: the paper texture, and the corner pattern (rings of dots
// around the top-right corner) at 6%. scripts/make-background.py prepares both: the paper as a tile, the pattern's
// ink as an image the script below reads each dot's size from. No shader library, no WebGL.
//
// The pattern alone makes way, so the paper keeps going: around the topic map (TopicMap.astro), clear inside the
// ellipse that fits the map's box and back to full strength at 1.55 times that size; on a page with the centred 720px
// text column (textColumn), behind a band as wide as the column, fading out between 16px and 112px on each side.
//
// With `persist`, going between two pages with the map without a full page load (Layout's introMap: Home and About),
// the router keeps this element as it is drawn, and its hole moves to the next page's map. A page with the text column
// has its own mask, so it never shares the element.
interface Props {
	/** The page has the centred 720px text column of articles: the pattern is cleared behind it. */
	textColumn?: boolean;
	/** Keep the element, as drawn, when the router (IntroRouter.astro) goes to another page that keeps it. */
	persist?: boolean;
}

const { textColumn = false, persist = false } = Astro.props;
// The attribute that transition:persist sets. The directive itself would also add Astro's view transition styles to
// every page with the background, the 404 page and /documents/ included, which never use the router.
const keep = persist && !textColumn ? 'page-background' : undefined;
---

<page-background aria-hidden="true" data-astro-transition-persist={keep}>
	<div class="paper"></div>
	<canvas class="pattern" data-mask={textColumn ? 'column' : undefined}></canvas>
</page-background>

<style>
	page-background {
		display: contents;
	}

	/* Both layers cover the viewport. 100vh is its largest height on phones, so their toolbar showing or hiding doesn't
	   resize the layers. */
	.paper,
	.pattern {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		pointer-events: none;
	}

	/* The tile is 140px, drawn at 2x, already laid at 6% on the white page. */
	.paper {
		background: url('../assets/background/paper.png') 0 0 / 140px 140px;
	}

	.pattern {
		display: block;
		opacity: 0.06;
	}

	/* The article column: min(720px, the frame's width less its 24px padding), centred. */
	.pattern[data-mask='column'] {
		--edge: calc(50% - min(360px, 50% - 24px));
		-webkit-mask-image: linear-gradient(90deg, #000 calc(var(--edge) - 112px), transparent calc(var(--edge) - 16px), transparent calc(100% - var(--edge) + 16px), #000 calc(100% - var(--edge) + 112px));
		mask-image: linear-gradient(90deg, #000 calc(var(--edge) - 112px), transparent calc(var(--edge) - 16px), transparent calc(100% - var(--edge) + 16px), #000 calc(100% - var(--edge) + 112px));
	}

	@media print {
		.paper,
		.pattern {
			display: none;
		}
	}
</style>

<script>
	import cornerUrl from '../assets/background/corner.png?url';

	// The corner pattern's settings (the prototype's): dots 7px apart on a hex grid turned 14°, ink #2b2b2b, reaching
	// 142% of the window's short side. corner.png covers 1.5 times that reach: its columns go from along the top edge
	// to straight down the right edge, its rows from the corner out.
	const PITCH = 7;
	const ANGLE = (14 * Math.PI) / 180;
	const REACH = 1.42;
	const ROWS_REACH = 1.5;
	const INK = '#2b2b2b';
	// Around the topic map: clear inside the ellipse that fits its box, full strength at 1.55 times that size.
	const HOLE = 1.55;

	type Ink = { ink: Uint8Array; cols: number; rows: number };
	let loading: Promise<Ink> | null = null;

	// If the image can't be had, the page stays on the paper alone, and the next draw tries again.
	function loadInk(): Promise<Ink> {
		loading ??= (async () => {
			const img = new Image();
			img.src = cornerUrl;
			await img.decode();
			const c = document.createElement('canvas');
			c.width = img.naturalWidth;
			c.height = img.naturalHeight;
			const g = c.getContext('2d', { willReadFrequently: true })!;
			g.drawImage(img, 0, 0);
			const rgba = g.getImageData(0, 0, c.width, c.height).data;
			const ink = new Uint8Array(c.width * c.height);
			for (let i = 0; i < ink.length; i++) ink[i] = rgba[i * 4];
			return { ink, cols: c.width, rows: c.height };
		})();
		loading.catch(() => {
			loading = null;
		});
		return loading;
	}

	// At 6%, twice the CSS pixels is plenty.
	const pixelRatio = () => Math.min(2, window.devicePixelRatio || 1);

	function draw(cv: HTMLCanvasElement, { ink, cols, rows }: Ink): number[] | null {
		const W = cv.clientWidth;
		const H = cv.clientHeight;
		const dpr = pixelRatio();
		if (!W || !H) return null;
		cv.width = Math.round(W * dpr);
		cv.height = Math.round(H * dpr);
		const g = cv.getContext('2d')!;
		g.setTransform(dpr, 0, 0, dpr, 0, 0);
		const R = Math.min(W, H) * REACH;
		const ax = Math.cos(ANGLE) * PITCH;
		const ay = Math.sin(ANGLE) * PITCH;
		const bx = Math.cos(ANGLE + Math.PI / 3) * PITCH;
		const by = Math.sin(ANGLE + Math.PI / 3) * PITCH;
		const N = Math.ceil(Math.hypot(W, H) / PITCH) + 2;
		const toRow = rows / R / ROWS_REACH;
		g.fillStyle = INK;
		g.beginPath();
		// The grid turns about the middle of the window. Along each of its rows, only the dots on screen.
		for (let j = -N; j <= N; j++) {
			const x0 = W / 2 + j * bx;
			const y0 = H / 2 + j * by;
			const from = Math.ceil(Math.max((-PITCH - x0) / ax, (-PITCH - y0) / ay));
			const to = Math.floor(Math.min((W + PITCH - x0) / ax, (H + PITCH - y0) / ay));
			for (let i = from; i <= to; i++) {
				const x = x0 + i * ax;
				const y = y0 + i * ay;
				const dx = W - x;
				const fr = Math.sqrt(dx * dx + y * y) * toRow - 0.5;
				if (fr >= rows - 1) continue;
				const fu = Math.min(cols - 1, Math.max(0, (Math.atan2(y, dx) / (Math.PI / 2)) * cols - 0.5));
				const r0 = Math.max(0, Math.floor(fr));
				const u0 = Math.min(cols - 2, Math.floor(fu));
				const tr = Math.max(0, fr - r0);
				const tu = fu - u0;
				const o = r0 * cols + u0;
				const d = (ink[o] * (1 - tr) * (1 - tu) + ink[o + 1] * (1 - tr) * tu + ink[o + cols] * tr * (1 - tu) + ink[o + cols + 1] * tr * tu) / 255;
				if (d <= 0.03) continue;
				const rad = 0.5 * PITCH * d;
				g.moveTo(x + rad, y);
				g.arc(x, y, rad, 0, 2 * Math.PI);
			}
		}
		g.fill();
		return [W, H, dpr];
	}

	class PageBackground extends HTMLElement {
		#canvas: HTMLCanvasElement | null = null;
		#drawn: number[] | null = null;
		#drawing = false;
		#mask = '';
		#frame = 0;
		#timer = 0;
		#mapObserver = new ResizeObserver(() => this.#queueHole());
		#sizeObserver = new ResizeObserver(() => this.#resized());

		// Runs again if the element is moved, for example kept from one page to the next: what is drawn stays.
		connectedCallback() {
			this.#canvas = this.querySelector('canvas.pattern');
			if (!this.#canvas) return;
			addEventListener('scroll', this.#queueHole, { passive: true });
			addEventListener('resize', this.#resized);
			addEventListener('load', this.#queueHole);
			document.fonts?.ready.then(this.#queueHole);
			// The map moves when it changes size, or when the page above it does.
			const map = document.querySelector('topic-map');
			if (map) {
				this.#mapObserver.observe(map);
				this.#mapObserver.observe(document.body);
			}
			// Also tells when the pattern is first laid out, or shown after being hidden.
			this.#sizeObserver.observe(this.#canvas);
			this.#updateHole();
		}

		disconnectedCallback() {
			removeEventListener('scroll', this.#queueHole);
			removeEventListener('resize', this.#resized);
			removeEventListener('load', this.#queueHole);
			this.#mapObserver.disconnect();
			this.#sizeObserver.disconnect();
			clearTimeout(this.#timer);
		}

		#draw() {
			const cv = this.#canvas!;
			if (this.#drawing || !cv.clientWidth || !cv.clientHeight) return;
			this.#drawing = true;
			loadInk()
				.then((data) => {
					this.#drawn = draw(cv, data);
				})
				.catch(() => {})
				.finally(() => {
					this.#drawing = false;
				});
		}

		// Drawn once. While the window is resized the browser stretches what is drawn; once resizing stops, the pattern
		// is drawn again, and only if the window changed by more than a tenth either way, or moved to a screen with
		// another pixel density.
		#changedALot() {
			if (!this.#drawn) return true;
			const [W, H, dpr] = this.#drawn;
			const cv = this.#canvas!;
			return Math.abs(cv.clientWidth - W) > W / 10 || Math.abs(cv.clientHeight - H) > H / 10 || pixelRatio() !== dpr;
		}

		#resized = () => {
			this.#queueHole();
			clearTimeout(this.#timer);
			if (!this.#drawn) return this.#draw();
			this.#timer = window.setTimeout(() => {
				if (this.#changedALot()) this.#draw();
			}, 200);
		};

		#queueHole = () => {
			if (!this.#frame) {
				this.#frame = requestAnimationFrame(() => {
					this.#frame = 0;
					this.#updateHole();
				});
			}
		};

		// The pattern is fixed, so the hole around the map moves with the map as the page scrolls.
		#updateHole() {
			const cv = this.#canvas!;
			if (cv.dataset.mask === 'column') return;
			const map = document.querySelector('topic-map');
			let next = 'none';
			if (map) {
				const r = map.getBoundingClientRect();
				const rx = (r.width / 2) * HOLE;
				const ry = (r.height / 2) * HOLE;
				const cx = r.left + r.width / 2;
				const cy = r.top + r.height / 2;
				// Off screen, the hole leaves the pattern whole.
				if (r.width && cy + ry > 0 && cy - ry < cv.clientHeight) {
					next = `radial-gradient(${rx}px ${ry}px at ${cx}px ${cy}px, transparent 62%, rgba(0, 0, 0, 0.5) 80%, #000 100%)`;
				}
			}
			if (next !== this.#mask) {
				this.#mask = next;
				cv.style.setProperty('-webkit-mask-image', next);
				cv.style.setProperty('mask-image', next);
			}
		}
	}

	customElements.define('page-background', PageBackground);
</script>
