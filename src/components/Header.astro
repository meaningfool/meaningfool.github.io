---
// The site header: the wordmark on the left, the navigation on the right. The current page's link is in ink,
// underlined in the accent colour. The navigation stays visible on phones.
import Wordmark from './Wordmark.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="head">
	<Wordmark />
	<nav class="nav" aria-label="Main">
		{links.map(({ href, label }) => (
			<a href={href} aria-current={href === here ? 'page' : undefined}>{label}</a>
		))}
	</nav>
</header>

<style>
	.head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		min-height: 84px;
		border-bottom: 1px solid var(--line);
	}

	.nav {
		display: flex;
		gap: 22px;
		font-size: 13px;
	}

	.nav a {
		color: var(--muted);
		text-decoration: none;
	}

	.nav a:hover {
		color: var(--ink);
	}

	.nav a[aria-current='page'] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 6px;
	}
</style>
