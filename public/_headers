# Cloudflare Workers reads this file; it isn't served there.
# Cloudflare sends text files as plain text/plain, and browsers then decode the
# emoji and accents in llms-full.txt as Windows-1252, so add the charset.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8

# Web Analytics' automatic setup adds its beacon to every page, but /documents/
# links carry a private access token: no-transform tells Cloudflare not to add it.
# The rest is Cloudflare's default for pages.
/documents/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
